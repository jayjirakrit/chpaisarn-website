---
import ProductTable from "@/components/table/ProductTable.astro";
import type { TableRow } from "@/components/table/ProductTable.astro";

type ProductDetailProps = {
  pidTitle?: string;
  pidDesc?: string;
  specTitle?: string;
  tableContent?: TableRow[];
  highlightTitle?: string;
  highlightItems?: string[];
};

const { pidTitle, pidDesc, specTitle, tableContent, highlightTitle, highlightItems } = Astro.props as ProductDetailProps;
---

<section class="product-info-detail-section">
  <div class="pid-container">
    <div class="pid-spec">
      <h2>{specTitle}</h2>
      <ProductTable rows={tableContent} />
    </div>
  </div>

  <div class="pid-highlight">
    <h3 class="pid-highlight-title">{highlightTitle}</h3>
    <div class="pid-highlight-desc">
      {
        highlightItems?.map((item) => (
          <div class="flex gap-3 items-start">
            <svg
              class="w-[1.5em] h-auto shrink-0"
              viewBox="0 0 20 22"
              fill="none"
              xmlns="http://www.w3.org/2000/svg">
              <path
                d="M8.6 16.6L15.65 9.55L14.25 8.15L8.6 13.8L5.75 10.95L4.35 12.35L8.6 16.6ZM10 22C8.61667 22 7.31667 21.7375 6.1 21.2125C4.88333 20.6875 3.825 19.975 2.925 19.075C2.025 18.175 1.3125 17.1167 0.7875 15.9C0.2625 14.6833 0 13.3833 0 12C0 10.6167 0.2625 9.31667 0.7875 8.1C1.3125 6.88333 2.025 5.825 2.925 4.925C3.825 4.025 4.88333 3.3125 6.1 2.7875C7.31667 2.2625 8.61667 2 10 2C11.3833 2 12.6833 2.2625 13.9 2.7875C15.1167 3.3125 16.175 4.025 17.075 4.925C17.975 5.825 18.6875 6.88333 19.2125 8.1C19.7375 9.31667 20 10.6167 20 12C20 13.3833 19.7375 14.6833 19.2125 15.9C18.6875 17.1167 17.975 18.175 17.075 19.075C16.175 19.975 15.1167 20.6875 13.9 21.2125C12.6833 21.7375 11.3833 22 10 22ZM10 20C12.2333 20 14.125 19.225 15.675 17.675C17.225 16.125 18 14.2333 18 12C18 9.76667 17.225 7.875 15.675 6.325C14.125 4.775 12.2333 4 10 4C7.76667 4 5.875 4.775 4.325 6.325C2.775 7.875 2 9.76667 2 12C2 14.2333 2.775 16.125 4.325 17.675C5.875 19.225 7.76667 20 10 20Z"
                fill="#96F6BE"
              />
            </svg>
            <h6>{item}</h6>
          </div>
        ))
      }
    </div>
  </div>
</section>

<script></script>

<style>
  .product-info-detail-section {
    display: flex;
    flex-direction: column;
    gap: 4rem;
    padding: 4rem 0.75rem;
  }

  .pid-container {
    display: flex;
    flex-direction: column;
    gap: 4rem;
  }

  .pid-spec {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .pid-highlight {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    background-color: var(--primary-50);
    font-weight: 400;
    padding: 2rem;
    border: 1.5px solid #c4c6d0;
  }

  .pid-highlight-title {
    padding-bottom: 1rem;
    border-bottom: 1.5px solid #c4c6d0;
  }

  .pid-highlight-desc {
    font-weight: 500;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  @media screen and (min-width: 768px) {
    .product-info-detail-section {
      padding: 4rem 3rem;
    }
  }

  @media screen and (min-width: 1028px) {
    .product-info-detail-section {
      flex-direction: row;
      gap: 1.5rem;
    }

    .pid-container {
      flex: 2;
    }

    .pid-highlight {
      flex: 1;
    }
  }
</style>
