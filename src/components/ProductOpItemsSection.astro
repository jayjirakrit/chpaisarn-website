---
import { Image } from "astro:assets";

const optionsTitle: string = Astro.props.optionsTitle;
const optionsDescription: string = Astro.props.optionsDescription;
const itemOptions: { label: string; title: string; img: any; imgDescription: string }[] = Astro.props.itemOptions;
---

<section class="options-section">
  <div class="options-head">
    <h2 class="options-title heading-h2">{optionsTitle}</h2>
    <p class="options-description body-text">{optionsDescription}</p>
  </div>

  <div class="option-items-content">
    {
      itemOptions.map((item) => (
        <div class="option-items-card">
          <div class="option-items-card-header">
            <span class="option-items-card-label">{item.label}</span>
            <h3 class="option-items-card-title">{item.title}</h3>
          </div>
          <div class="option-items-card-features">
            <Image src={item.img} alt={item.imgDescription} />
          </div>
        </div>
      ))
    }
  </div>

  <style>
    .options-section {
      background-color: white;
      background-size: cover;
      background-position: center;
      padding: 3rem 2rem;
    }

    .options-head {
      text-align: center;
      margin-bottom: 3rem;
    }

    .options-title {
      color: var(--primary-900);
      margin-bottom: 1.5rem;
    }

    .options-description {
      margin-bottom: 1rem;
    }

    .option-items-content {
      display: grid;
      grid-template-columns: 1fr; /* 1 column on mobile */
      gap: 2rem;
    }

    .option-items-card {
      width: 100%;
      background-color: var(--primary-50);
      border-radius: 5px;
      border: 1px solid var(--primary-900);
      padding: 1rem;
    }

    .option-items-card-header {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: space-between;
      padding-bottom: 1rem;
      color: black;
    }

    .option-items-card-label {
      font-family: "Space Grotesk", sans-serif;
      font-weight: 700;
      font-size: 0.75rem;
      color: black;
      padding-bottom: 0.5rem;
      border-bottom: 3px solid #9af9cf;
    }

    .option-items-card-title {
      font-family: "Hanken Grotesk", sans-serif;
      font-weight: 700;
      font-size: 1.75rem;
      color: black;
    }

    .option-items-card-features {
      list-style-type: disc;
      color: white;
      display: flex;
      justify-content: center;
    }

    .option-items-card-features li {
      margin-bottom: 0.75rem;
      font-size: 1rem;
      line-height: 1.4;
    }

    /* Tablet and above (min-width) */
    @media only screen and (min-width: 768px) {
      .options-section {
        padding: 5rem 6.25rem;
        min-height: auto;
      }

      .options-head {
        text-align: start;
      }

      .option-items-content {
        grid-template-columns: repeat(3, 1fr); /* exactly 3 equal columns */
        gap: 4rem;
      }

      .option-items-card {
        padding: 2rem;
      }

      .option-items-card-header {
        align-items: flex-start;
        flex-direction: row;
      }

      .option-items-card-label {
        font-size: 1rem;
      }

      .option-items-card-title {
        font-size: 2rem;
      }

      .option-items-card-features {
        list-style-type: disc;
        color: white;
      }

      .option-items-card-features li {
        margin-bottom: 0.75rem;
        font-size: 1rem;
        line-height: 1.4;
      }
    }

    /* Desktop and above */
    @media only screen and (min-width: 1024px) {
    }
  </style>
</section>
