---
import CompanyBgImg from "@/assets/company/intro_bg.png";
import CompanyBg01Img from "@/assets/company/factory_01_bg.svg";
import CustomizeBg01Img from "@/assets/spec_07.png";
import CustomizeBg02Img from "@/assets/spec_06.png";
import CustomizeBg03Img from "@/assets/spec_09.png";
import CustomizeBg04Img from "@/assets/spec_03.png";
import CustomizeBg05Img from "@/assets/spec_08.png";
import ProductIntroSection from "@/components/ProductIntroSection.astro";
import ProductOpItemsSection from "@/components/ProductOpItemsSection.astro";
import ProductOptionNav from "@/components/ProductOptionNav.astro";
import CustomStepsSection from "@/components/CustomStepsSection.astro";
import ContactSection from "@/components/ContactSection.astro";
import HelmetMitImg from "@/assets/products/helmet/helmet_mit_rif.png";
import HelmetNewFastImg from "@/assets/products/helmet/helmet_new_fast.png";
import HelmetSouthImg from "@/assets/products/helmet/helmet_south.png";
import HelmetFastImg from "@/assets/products/helmet/helmet_fast_rif.png";
import HelmetFastGreenImg from "@/assets/products/helmet/helmet_fast_green.png";
import HelmetWendyImg from "@/assets/products/helmet/helmet_wendy.png";
import HelmetAirFrameImg from "@/assets/products/helmet/helmet_air_frame.png";
import type { Lang } from "@/i18n/types";
import { useTranslations } from "@/i18n/utils";

interface Props {
  lang?: Lang;
}

const { lang = "en" } = Astro.props;
const t = useTranslations(lang);

const helmetImgs = [HelmetMitImg, HelmetNewFastImg, HelmetSouthImg, HelmetFastImg, HelmetFastGreenImg, HelmetWendyImg, HelmetAirFrameImg];
const stepImgs = [CustomizeBg01Img.src, CustomizeBg02Img.src, CustomizeBg03Img.src, CustomizeBg04Img.src, CustomizeBg05Img.src];

const itemOptions = t("helmet.itemOptions").map((opt, i) => ({ ...opt, img: helmetImgs[i] }));
const customizationSteps = t("helmet.customizationSteps").map((step, i) => ({ ...step, image: stepImgs[i] }));
---

<!-- Introduction Section -->
<ProductIntroSection
  companyBgImg={CompanyBgImg}
  pageTitle={t("helmet.hero.title")}
  pageDescription={t("helmet.hero.description")}
/>

<!--Options Navigation -->
<ProductOptionNav optionsNav={t("helmet.optionsNav")} />

<!-- Your Item Options Section -->
<div id="your-options">
  <ProductOpItemsSection
    optionsTitle={t("helmet.options.title")}
    optionsDescription={t("helmet.options.description")}
    itemOptions={itemOptions}
  />
</div>

<div class="overlay-section h-32"></div>

<!-- Customization Section -->
<div id="customization">
  <CustomStepsSection
    customizeTitle={t("helmet.customize.title")}
    customizeDescription={t("helmet.customize.description")}
    customizationSteps={customizationSteps}
  />
</div>

<!-- Contact Section -->
<ContactSection
  bgImg={CompanyBg01Img}
  contactTitle={t("helmet.cta.title")}
  contactDescription={t("helmet.cta.description")}
  lang={lang}
/>

<style></style>

<script is:inline type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: "https://ch-paisarn.com/" },
    { "@type": "ListItem", position: 2, name: "Products", item: "https://ch-paisarn.com/products" },
    { "@type": "ListItem", position: 3, name: "Ballistic Helmets", item: "https://ch-paisarn.com/products/ballistic-helmets" },
  ],
})} />
