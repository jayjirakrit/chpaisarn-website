---
import CompanyBgImg from "@/assets/company/company_02_bg.svg";
import CompanyBg01Img from "@/assets/company/factory_01_bg.svg";
import CustomizeBg01Img from "@/assets/spec_07.png";
import CustomizeBg02Img from "@/assets/spec_06.png";
import CustomizeBg03Img from "@/assets/spec_09.png";
import CustomizeBg04Img from "@/assets/spec_03.png";
import CustomizeBg05Img from "@/assets/spec_05.png";
import ProductIntroSection from "@/components/ProductIntroSection.astro";
import ProductOpItemsSection from "@/components/ProductOpItemsSection.astro";
import ProductOptionNav from "@/components/ProductOptionNav.astro";
import CustomStepsSection from "@/components/CustomStepsSection.astro";
import ContactSection from "@/components/ContactSection.astro";
import CvcHelmentImg from "@/assets/products/helmet/cvc_helmet.svg";
import FastHelmet01Img from "@/assets/products/helmet/fast_helmet_01.svg";
import FastHelmet02Img from "@/assets/products/helmet/fast_helmet_02.svg";
import NijHelmetImg from "@/assets/products/helmet/nij_helmet.svg";
import Helmet05Img from "@/assets/products/helmet/helmet_05.svg";
import Helmet06Img from "@/assets/products/helmet/helmet_06.svg";
import Helmet07Img from "@/assets/products/helmet/helmet_07.svg";
import Helmet08Img from "@/assets/products/helmet/helmet_08.svg";

// Hero section data
const pageTitle = "Ballistic Helmets";
const pageDescription =
  "Engineered from advanced materials to provide high-impact defense against ballistic threats and blunt trauma without sacrificing mobility. These lightweight, durable helmets are fully customizable in shape and specification to meet unique operational or environmental demands.";

// Your Options section data
const optionsTitle = "Your Options";
const optionsDescription = "";

// Options Navigation data
const optionsNav = ["Your Options", "Customization"];

// Customization section data
const customizeTitle = "Built to Your Specification";
const customizeDescription =
  "Every unit has different requirements. We work directly with agencies and procurement teams to configure the right plate solution — from material grade and plate geometry to surface finish and identification markings. Our team manages the entire process in-house, from design through to final inspection. Please specify your requirements when submitting your procurement inquiry";

// Item options data
const itemOptions = [
  {
    label: "Option 1",
    title: "CVC Helmet",
    img: CvcHelmentImg,
    imgDescription: "CVC Helmet",
  },
  {
    label: "Option 2",
    title: "Fast Helmet",
    img: FastHelmet01Img,
    imgDescription: "Fast Helmet",
  },
  {
    label: "Option 3",
    title: "Fast Helmet",
    img: FastHelmet02Img,
    imgDescription: "Fast Helmet",
  },
  {
    label: "Option 4",
    title: "NIJ Level IV-",
    img: NijHelmetImg,
    imgDescription: "NIJ Level IV- Helmet",
  },
  {
    label: "Option 5",
    title: "PASGT",
    img: Helmet05Img,
    imgDescription: "PASGT Helmet",
  },
  {
    label: "Option 6",
    title: "Ballistic",
    img: Helmet06Img,
    imgDescription: "Ballistic Helmet",
  },
  {
    label: "Option 7",
    title: "Ballistic",
    img: Helmet07Img,
    imgDescription: "Ballistic Helmet",
  },
  {
    label: "Option 8",
    title: "Ballistic",
    img: Helmet08Img,
    imgDescription: "Ballistic Helmet",
  },
];

const customizationSteps = [
  {
    step: "Step 1",
    title: "Materials",
    image: CustomizeBg01Img.src,
    items: [
      {
        name: "UHMWPE Core",
        desc: "The foundation of every CHP® plate — providing high ballistic resistance and multi-hit capability at low weight. Sourced from certified global manufacturers including Dyneema®.",
      },
      {
        name: "Ceramic Composite",
        desc: "Designed for military and law enforcement, offering Level III or Level IV bulletproof protection with the option to integrate stab-resistant inserts for comprehensive defense.",
      },
      {
        name: "Custom Material Sourcing",
        desc: "For agencies with specific performance or operational requirements, our team works directly with procurement officers to source and configure the right material specification for your mission.",
      },
    ],
  },
  {
    step: "Step 2",
    title: "Covering Materials",
    image: CustomizeBg02Img.src,
    content: "Choose from wide size range from XS to XXL, with custom sizing for a tailored fit.",
    items: [
      {
        name: "Concealable Armor",
        desc: "Fully customizable covering materials selected for durability, moisture resistance, and breathability to suit specific tactical environments or weight requirements.",
      },
      {
        name: "Environmental Resilience",
        desc: "Specialized options engineered to maintain structural integrity and performance in harsh climates and extreme operational conditions.",
      },
      {
        name: "Mission-Specific Aesthetics",
        desc: "Complete control over design, color, and camouflage patterns to ensure seamless integration with uniforms and team requirements.",
      },
    ],
  },
  {
    step: "Step 3",
    title: "Colors",
    image: CustomizeBg03Img.src,
    items: [
      {
        name: "Size",
        desc: "Fully customizable covering materials selected for durability, moisture resistance, and breathability to suit specific tactical environments or weight requirements.",
      },
      {
        name: "Curvature",
        desc: "Specialized options engineered to maintain structural integrity and performance in harsh climates and extreme operational conditions.",
      },
      {
        name: "Cut Shape",
        desc: "Complete control over design, color, and camouflage patterns to ensure seamless integration with uniforms and team requirements.",
      },
      {
        name: "Trauma Reduction",
        desc: "Complete control over design, color, and camouflage patterns to ensure seamless integration with uniforms and team requirements.",
      },
      {
        name: "Plate Marking & Identification",
        desc: "Complete control over design, color, and camouflage patterns to ensure seamless integration with uniforms and team requirements.",
      },
    ],
  },
  {
    step: "Step 4",
    title: "Protection Area",
    image: CustomizeBg04Img.src,
    items: [
      { name: "Specific Areas", desc: "Choose to focus protection on key areas like the neck, abdomen, groin, or shoulders" },
      { name: "Full-body Armor", desc: "opt for full-body armor for ultimate defense." },
    ],
  },
  {
    step: "Step 5",
    title: "Additional Accessories and Upgrades",
    image: CustomizeBg05Img.src,
    items: [
      {
        name: "Hard Armor Plates",
        desc: "For enhanced ballistic protection, add ceramic or polyethylene plates for Level III or IV protection against high-caliber rounds and armor-piercing projectiles, alongside fragmentation defense.",
      },
      {
        name: "Removable Components",
        desc: "Neck, shoulder, and groin protectors can be added or removed for customizable protection based on the situation.",
      },
      {
        name: "Insertable Plates",
        desc: "Add ceramic or polyethylene plates for Level III or IV protection, offering defense against high-caliber rounds and armor-piercing projectiles, as well as enhanced fragmentation defense.",
      },
      {
        name: "Anti-Stab Inserts",
        desc: "Customize armor with stab-resistant inserts to provide additional protection from blades, spikes, and other sharp objects in vulnerable areas.",
      },
    ],
  },
];

// Contact section data
const ctaTitle = "Get in Touch";
const ctaDescription =
  "Contact us to learn more about our defense solutions or to discuss your specific operational requirements. Our team is ready to provide the expertise and custom-engineered armor solutions needed to meet your mission objectives.";
---

<!-- Introduction Section -->
<ProductIntroSection companyBgImg={CompanyBgImg} pageTitle={pageTitle} pageDescription={pageDescription} />

<!--Options Navigation -->
<ProductOptionNav optionsNav={optionsNav} />

<!-- Your Item Options Section -->
<ProductOpItemsSection optionsTitle={optionsTitle} optionsDescription={optionsDescription} itemOptions={itemOptions} />

<div class="overlay-section h-32"></div>

<!-- Customization Section -->
<CustomStepsSection customizeTitle={customizeTitle} customizeDescription={customizeDescription} customizationSteps={customizationSteps} />

<!-- Contact Section -->
<ContactSection bgImg={CompanyBg01Img} contactTitle={ctaTitle} contactDescription={ctaDescription} />

<style></style>
