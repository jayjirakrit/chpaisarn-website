---
import CompanyBgImg from "@/assets/company/intro_bg.png";
import CompanyBg01Img from "@/assets/company/factory_01_bg.svg";
import CustomizeBg01Img from "@/assets/spec_06.png";
import CustomizeBg02Img from "@/assets/spec_07.png";
import CustomizeBg03Img from "@/assets/spec_02.png";
import CustomizeBg04Img from "@/assets/spec_08.png";
import IntroSection from "@/components/IntroSection.astro";
import ProductOpItemsSection from "@/components/ProductOpItemsSection.astro";
import ProductOptionNav from "@/components/ProductOptionNav.astro";
import CustomStepsSection from "@/components/CustomStepsSection.astro";
import ContactSection from "@/components/ContactSection.astro";
import PlateIIIImg from "@/assets/products/plate/plate_III.png";
import PlateIIIPlusImg from "@/assets/products/plate/plate_III+.png";
import PlateIVImg from "@/assets/products/plate/plate_IV.png";
import PlateIVMinusImg from "@/assets/products/plate/plate_IV-.png";
import { Image } from "astro:assets";
import BoxIcon from "@/assets/checkbox_icon.svg";
import type { Lang } from "@/i18n/types";
import { useTranslations, breadcrumbUrl } from "@/i18n/utils";

interface Props {
  lang?: Lang;
}

const { lang = "en" } = Astro.props;
const t = useTranslations(lang);

const breadcrumbLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: lang === "th" ? "หน้าแรก" : "Home", item: breadcrumbUrl(lang, "/") },
    { "@type": "ListItem", position: 2, name: lang === "th" ? "สินค้า" : "Products", item: breadcrumbUrl(lang, "/products") },
    {
      "@type": "ListItem",
      position: 3,
      name: lang === "th" ? "แผ่นเกราะกันกระสุน" : "Ballistic Plates",
      item: breadcrumbUrl(lang, "/products/ballistic-plates"),
    },
  ],
};

const productSpecs = [
  {
    class: "Level III",
    rows: [
      { ammo: ["7.62 x 51 FMJ"], std: "1.2", prem: "0.90", mat: "UHMWPE" },
      {
        ammo: ["7.62 x 51 FMJ", "7.62 x 39 AK47 MSC"],
        std: "1.33",
        prem: "0.98",
        mat: "UHMWPE",
      },
    ],
  },
  {
    class: "Level III ++",
    rows: [
      {
        ammo: ["7.62 x 51 FMJ", "7.62 x 39 AK47 MSC", "5.56 x 45 SS109 / M193"],
        std: "1.80*",
        prem: "1.35** - 1.45**",
        mat: "UHMWPE + Ceramic (Sic * / B4C** )",
      },
    ],
  },
  {
    class: "Level IV-",
    rows: [
      {
        ammo: ["7.62 x 39 AK47 API"],
        std: "2.30*",
        prem: "1.80**",
        mat: "UHMWPE + Ceramic (Sic * / B4C** )",
      },
    ],
  },
  {
    class: "Level IV",
    rows: [
      {
        ammo: [".30 M2 AP", "7.62 x 54R API B-32"],
        std: "2.35** / 2.50*",
        prem: "2.10**",
        mat: "UHMWPE + Ceramic (Sic * / B4C** )",
      },
    ],
  },
];

import optionBg from "@/assets/company/protection_bg.png";
import optionBgMobile from "@/assets/company/protection_bg_mobile.png";

const plateImgs = [PlateIIIImg, PlateIIIPlusImg, PlateIVMinusImg, PlateIVImg];
const stepImgs = [CustomizeBg01Img.src, CustomizeBg02Img.src, CustomizeBg03Img.src];

const itemOptions = t("plate.itemOptions").map((opt, i) => ({ ...opt, img: plateImgs[i] }));
const customizationSteps = t("plate.customizationSteps").map((step, i) => ({ ...step, image: stepImgs[i] }));
---

<!-- Introduction Section -->
<IntroSection
  companyBgImg={CompanyBgImg}
  pageTitle={t("plate.hero.title")}
  pageDescription={t("plate.hero.description")}
/>

<!--Options Navigation -->
<ProductOptionNav optionsNav={t("plate.optionsNav")} />

<!-- Your Item Options Section -->
<div id="your-options">
  <ProductOpItemsSection
    optionsTitle={t("plate.options.title")}
    optionsDescription={t("plate.options.description")}
    itemOptions={itemOptions}
    showModal={true}
  />
</div>

<!-- Regulation Section -->
<section
  id="standards-compliance"
  class="reg-section"
  style={`--bg-mobile: url(${optionBgMobile.src}); --bg-desktop: url(${optionBg.src})`}
>
  <div class="reg-top">
    <div>
      <h3 class="reg-title-h2 text-(--primary-900) mb-2">{t("plate.reg.title")}</h3>
      <p class="body-text">{t("plate.reg.description")}</p>
    </div>
    <div class="reg-compliance">
      <div class="reg-header">
        <div class="reg-title-wrap body-text">
          <h6 class="reg-title">{t("plate.reg.theRegulation")}</h6>
        </div>
        <h3 class="reg-description">{t("plate.reg.compliance")}</h3>
      </div>
      <div class="reg-content">
        {
          t("plate.regItems").map((item) => (
            <div class="reg-card">
              <div class="reg-card-header">
                <span class="reg-icon">
                  <Image src={BoxIcon} alt="Box Icon" />
                </span>
                <div>
                  <h5 class="reg-card-title">{item.title}</h5>
                </div>
              </div>
              <p class="reg-card-description body-text">{item.description}</p>
            </div>
          ))
        }
      </div>
    </div>
  </div>

  <div class="reg-spec">
    <h2 class="reg-spec-title">
      {t("plate.reg.specTitle")}
    </h2>
    <div class="reg-spec-table-wrap">
      <table class="reg-spec-table">
        <thead>
          <tr class="reg-spec-header-main">
            <th rowspan="2" set:html={t("plate.reg.colClass").replace("\n", "<br />")}></th>
            <th rowspan="2">{t("plate.reg.colAmmo")}</th>
            <th colspan="2">{t("plate.reg.colWeight")}</th>
            <th rowspan="2" set:html={t("plate.reg.colMaterial").replace("\n", "<br />")}></th>
          </tr>
          <tr class="reg-spec-header-sub">
            <th class="reg-spec-weight-col">{t("plate.reg.colStandard")}</th>
            <th class="reg-spec-weight-col">{t("plate.reg.colPremium")}</th>
          </tr>
        </thead>
        <tbody>
          {
            productSpecs.map((spec) =>
              spec.rows.map((row, idx) => (
                <tr>
                  {idx === 0 && (
                    <td rowspan={spec.rows.length} class="reg-spec-class">
                      {spec.class}
                    </td>
                  )}
                  <td class="reg-spec-ammo">
                    <ul>
                      {row.ammo.map((item) => (
                        <li>{item}</li>
                      ))}
                    </ul>
                  </td>
                  <td>{row.std}</td>
                  <td>{row.prem}</td>
                  {idx === 0 && <td rowspan={spec.rows.length}>{row.mat}</td>}
                </tr>
              )),
            )
          }
        </tbody>
      </table>
    </div>
  </div>
</section>

<!-- Customization Section -->
<div id="customization">
  <CustomStepsSection
    customizeTitle={t("plate.customize.title")}
    customizeDescription={t("plate.customize.description")}
    customizationSteps={customizationSteps}
  />
</div>

<!-- Contact Section -->
<ContactSection
  bgImg={CompanyBg01Img}
  contactTitle={t("plate.cta.title")}
  contactDescription={t("plate.cta.description")}
  lang={lang}
/>

<style>
  /* Regulation Section */
  .reg-section {
    display: flex;
    flex-direction: column;
    gap: 3rem;
    background-color: white;
    background-image: var(--bg-mobile);
    background-size: cover;
    background-position: center;
    padding: 3rem 1.25rem;
  }

  .reg-top {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    align-items: center;
  }

  .reg-header {
    display: none;
    flex-direction: column;
    width: 100%;
    flex-basis: 100%;
    max-width: 242px;
  }

  .reg-title-wrap {
    color: black;
    font-weight: bold;
    display: flex;
    justify-content: center;
  }

  .reg-title {
    display: inline-block;
    padding-bottom: 0.5rem;
    margin-bottom: 1rem;
    border-bottom: 3px solid var(--secondary-500);
  }

  /* h2-scale applied to an h3 tag */
  .reg-title-h2 {
    font-family: var(--font-hanken);
    font-weight: 700;
    font-size: 2.25rem;
    line-height: 1.2;
  }

  @media only screen and (min-width: 768px) {
    .reg-title-h2 { font-size: 3rem; }
  }

  @media only screen and (min-width: 1024px) {
    .reg-title-h2 { font-size: 3.625rem; }
  }

  .reg-description {
    color: var(--primary-900);
    margin-bottom: 1rem;
    text-align: center;
  }

  .reg-content {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
  }

  .reg-card {
    background-color: var(--primary-700);
    color: white;
    border-radius: 5px;
    border: 1px solid var(--primary-700);
    padding: 2rem;
    max-width: 600px;
  }

  .reg-card-header {
    display: flex;
    gap: 0.5rem;
  }

  .reg-card-title {
    margin-bottom: 0.75rem;
  }

  /* Spec table block */
  .reg-spec {
    display: flex;
    flex-direction: column;
    gap: 2.25rem;
  }

  /* h3-scale applied to an h2 tag */
  .reg-spec-title {
    color: var(--primary-900);
    font-size: 1.5rem;
    font-weight: 700;
    line-height: 1.2;
  }

  @media only screen and (min-width: 768px) {
    .reg-spec-title { font-size: 1.875rem; }
  }

  @media only screen and (min-width: 1024px) {
    .reg-spec-title { font-size: 2.375rem; }
  }

  .reg-spec-table-wrap {
    width: 100%;
    overflow-x: auto;
  }

  .reg-spec-table {
    width: 100%;
    border-collapse: collapse;
    font-family: "Hanken Grotesk", sans-serif;
  }

  .reg-spec-table thead th {
    background-color: #2465ae;
    color: #f0f0f0;
    font-weight: 400;
    font-size: 0.625rem;
    padding: 0.5rem 0.5rem;
    text-align: center;
    border: 1px solid #f0f0f0;
    line-height: 1.4;
  }

  .reg-spec-table .reg-spec-header-main th:first-child,
  .reg-spec-table .reg-spec-header-main th:last-child {
    font-weight: 700;
  }

  .reg-spec-table thead th[rowspan="2"] {
    vertical-align: middle;
  }

  .reg-spec-table .reg-spec-header-sub th {
    font-weight: 400;
    padding: 0.5rem 0.625rem;
    border-top: 1px solid #2465ae;
  }

  .reg-spec-table .reg-spec-weight-col {
    width: 4.5rem;
  }

  .reg-spec-table tbody td {
    background-color: white;
    border: 1px solid #d4d4d4;
    padding: 0.5rem 0.5rem;
    font-size: 0.625rem;
    color: #272727;
    line-height: 1.4;
  }

  .reg-spec-table .reg-spec-class {
    font-weight: 700;
  }

  .reg-spec-table .reg-spec-ammo {
    padding-left: 0;
  }

  .reg-spec-table .reg-spec-ammo ul {
    list-style: disc;
    margin: 0;
    padding-left: 1.5rem;
  }

  .reg-spec-table .reg-spec-ammo li {
    margin-bottom: 0.5rem;
  }

  .reg-spec-table .reg-spec-ammo li:last-child {
    margin-bottom: 0;
  }

  /* Tablet and above (min-width) */
  @media only screen and (min-width: 768px) {
    .reg-section {
      background-image: var(--bg-desktop);
      padding: 6.25rem;
    }

    .reg-spec-table thead th {
      font-size: 1rem;
      padding: 1rem 1.375rem;
    }

    .reg-spec-table .reg-spec-header-sub th {
      padding: 0.75rem 1.375rem;
    }

    .reg-spec-table .reg-spec-weight-col {
      width: 9rem;
    }

    .reg-spec-table tbody td {
      font-size: 1rem;
      padding: 1rem 1.375rem;
    }

    .reg-top {
      flex-direction: column;
      align-items: flex-start;
      gap: 4rem;
    }

    .reg-section {
      gap: 4rem;
    }

    .reg-compliance {
      display: flex;
      flex-direction: row;
      align-items: flex-start;
      gap: 3rem;
      width: 100%;
    }

    .reg-header {
      display: flex;
      flex-direction: column;
      flex-shrink: 0;
      width: 13rem;
      align-items: flex-start;
      padding-right: 2rem;
      border-right: 3px solid var(--secondary-500);
    }

    .reg-content {
      flex: 1;
      grid-template-columns: 1fr 1fr;
    }

    .reg-title-wrap {
      justify-content: flex-start;
    }

    .reg-description {
      text-align: left;
    }
  }

  /* Desktop and above */
  @media only screen and (min-width: 1024px) {
    .reg-section {
      padding: 6.25rem 13rem;
    }
  }
</style>

<script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />
