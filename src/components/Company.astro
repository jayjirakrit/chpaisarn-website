---
import CompanyBgImg from "@/assets/company/intro_bg.png";
import CtaBgImg from "@/assets/company/cta_bg.png";
import AboutUsBgImg from "@/assets/company/aboutus_bg.png";

import IntroSection from "@/components/IntroSection.astro";
import StatSection from "@/components/StatSection.astro";
import ContactSection from "@/components/ContactSection.astro";
import type { Lang } from "@/i18n/types";
import { useTranslations } from "@/i18n/utils";

interface Props {
  lang?: Lang;
}

const { lang = "en" } = Astro.props;
const t = useTranslations(lang);
---

<!-- Intro Section -->
<IntroSection
    companyBgImg={CompanyBgImg}
    pageTitle={t("company.intro.title")}
    pageDescription={t("company.intro.description")}
/>

<!-- Stat Section -->
<StatSection lang={lang} />

<!-- Legacy Section -->
<section id="legacy" class="legacy-section">
    <div class="legacy-header">
        <div class="legacy-title"></div>
        <div class="legacy-desc"></div>
    </div>

    <div class="legacy-content"></div>
</section>

<section
    id="aboutus"
    class="aboutus-section"
    style={`background-image: url(${AboutUsBgImg.src});`}
>
    <h2 class="aboutus-title">{t("company.aboutUsTitle")}</h2>
    <div class="aboutus-video aboutus-video-placeholder" id="aboutus-video">
        <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 68 48"
            width="68"
            height="48"
            aria-hidden="true"
        >
            <rect width="68" height="48" rx="10" fill="#ff0000"></rect>
            <polygon points="27,14 27,34 47,24" fill="white"></polygon>
        </svg>
    </div>
</section>

<!-- Contact Section -->
<ContactSection
    bgImg={CtaBgImg}
    contactTitle={t("company.cta.title")}
    contactDescription={t("company.cta.description")}
    lang={lang}
/>

<script>
    import $ from "jquery";

    $("#aboutus-video").on("click", function () {
        const $placeholder = $(this);
        const width = $placeholder.outerWidth();
        const height = $placeholder.outerHeight();
        const borderRadius = $placeholder.css("border-radius");
        $("<iframe>")
            .attr({
                src: "https://www.youtube.com/embed/FNiamannzMQ?si=D2Ef_kx26dmmBXeo",
                title: "YouTube video player",
                allow: "accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share",
                referrerpolicy: "strict-origin-when-cross-origin",
                allowfullscreen: "",
            })
            .css({
                width: width + "px",
                height: height + "px",
                borderRadius: borderRadius,
                display: "block",
                flexShrink: "0",
            })
            .replaceAll($placeholder);
    });
</script>

<style>
    .aboutus-section {
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
        display: flex;
        flex-direction: column;
        justify-content: center;
        padding: 3.5rem 1.25rem;
        gap: 3rem;
    }

    .aboutus-title {
        text-align: left;
        color: white;
    }

    .aboutus-video {
        background-color: white;
        display: flex;
        justify-content: center;
        align-items: center;
        border-radius: 1rem;
        height: 12.5rem;
        width: 100%;
        overflow: hidden;
        cursor: pointer;
    }

    @media only screen and (min-width: 768px) {
        .aboutus-section {
            align-items: center;
            padding: 4.5rem;
            gap: 3.5rem;
        }

        .aboutus-title {
            width: 100%;
        }

        .aboutus-video {
            height: 26.75rem;
            width: calc(100% - 2.5rem);
        }
        .aboutus-video svg {
            width: 140px;
            height: 80px;
        }
    }

    @media only screen and (min-width: 1024px) {
        .aboutus-section {
            padding: 6.25rem 14rem;
            gap: 4rem;
        }

        .aboutus-video {
            height: 38.25rem;
            width: 100%;
        }
        .aboutus-video svg {
            width: 150px;
            height: 100px;
        }
    }
</style>

<script is:inline type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: "https://ch-paisarn.com/" },
    { "@type": "ListItem", position: 2, name: "About Us", item: "https://ch-paisarn.com/company" },
  ],
})} />
