---
import HelmetFast01Img from "@/assets/products/helmet/helmet_fast_green.png";
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";

type ProductInfoProps = {
  productName: string;
  productsImg: ImageMetadata[];
  level: string;
  colors: Color[];
  sizes: String[];
  productDesc: string;
};

export type Color = {
  color: string;
  hex: string;
};

const productName = "Fast Helmet";
const productsImg = [HelmetFast01Img, HelmetFast01Img, HelmetFast01Img, HelmetFast01Img];
const level = "NIJ LEVEL IIIA";
const colors: Color[] = [
  { color: "red", hex: "" },
  { color: "blue", hex: "" },
  { color: "green", hex: "" },
];
const sizes = ["S", "M"];
const productDesc =
  "Engineered for elite tactical operations, the Model X combines advanced aramid composites with aerospace-grade ergonomic design. Offering unparalleled NIJ Level IIIA protection while maintaining a remarkably low profile and weight.";

// const { productName, productsImg, level, colors, sizes, productDesc } = Astro.props;
---

<section class="product-intro-section">
  <div class="product-intro-photo">
    <div class="product-intro-photo-main">
      <Image
        src={productsImg[0]}
        alt=""
      />
    </div>
    <div class="product-intro-photo-side">
      {
        productsImg.slice(1).map((sideImg) => (
          <div>
            <Image
              src={sideImg}
              alt=""
            />
          </div>
        ))
      }
    </div>
  </div>
  <div class="product-intro-content">
    <div class="product-intro-header">
      <h2 class="product-intro-title">{productName}</h2>
      {
        level && (
          <div class="product-intro-title-desc">
            <>
              <p>{level}</p>
              <span> Certified</span>
            </>
          </div>
        )
      }
    </div>
    <div class="product-intro-color">
      <p class="font-semibold">SIZES: {sizes.join(", ")}</p>
      <p class="font-semibold">COLOR: BLACK</p>
      <div class="product-intro-color-pallete">
        {colors.map((color) => <div color-pallete />)}
      </div>
    </div>

    <div class="product-intro-desc">
      <h6>{productDesc}</h6>
    </div>
  </div>
</section>

<script></script>

<style>
  .product-intro-section {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    padding: 4rem 1rem;
    position: relative;
  }

  .product-intro-section::after {
    content: "";
    position: absolute;
    bottom: 0;
    left: 10%; /* (100% - 80%) / 2 = 10% from each side */
    width: 80%;
    height: 1.5px;
    background-color: #c4c6d0;
  }

  .product-intro-section-photo {
  }

  .product-intro-photo {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .product-intro-photo-main {
    display: flex;
    justify-content: center;
    align-items: center;
    aspect-ratio: 16/9;
    border: 1.5px solid #c4c6d0;
  }

  .product-intro-photo-main img {
    width: 75%;
    object-fit: cover;
  }

  .product-intro-photo-side {
    display: flex;
    gap: 1rem;
  }

  .product-intro-photo-side img {
    object-fit: cover;
  }

  .product-intro-photo-side > div {
    border: 1.5px solid #c4c6d0;
  }

  .product-intro-header {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding-bottom: 1.5rem;
  }

  .product-intro-title-desc > p {
    background-color: var(--color-black);
    display: inline-flex;
    font-size: 0.75rem;
    font-weight: bold;
    color: var(--color-white);
    padding: 0.25rem 0.75rem;
  }

  .product-intro-title-desc > span {
    font-size: 0.75rem;
    font-weight: bold;
    background-color: var(--color-white);
    color: #215fa5;
    padding: 0.25rem 0.5rem;
  }

  .product-intro-color {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding-bottom: 2rem;
  }

  .product-intro-color-pallete {
    display: flex;
    gap: 1rem;
  }

  .product-intro-color-pallete [color-pallete] {
    height: 40px;
    width: 40px;
    background-color: #3b3b3b;
    border-radius: 12px;
  }

  .product-intro-desc {
    padding: 0 0 0 1rem;
    border-left: 3px solid var(--secondary-500);
  }
</style>
