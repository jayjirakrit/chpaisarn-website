---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import type { Color } from "@/i18n/types";

export type ProductInfoProps = {
  productName: string;
  productsImg: ImageMetadata[];
  level: string;
  colors: Color[];
  sizes: String[];
  productDesc: string;
};

const { productName, productsImg, level, colors, sizes, productDesc } = Astro.props as ProductInfoProps;
---

<section class="product-intro-section">
  <div class="product-intro-photo">
    <div class="product-intro-photo-main">
      <Image
        src={productsImg && productsImg[0]}
        alt=""
      />
    </div>
    <div class="product-intro-photo-side">
      {
        productsImg?.slice(1).map((sideImg) => (
          <div>
            <Image
              src={sideImg}
              alt=""
            />
          </div>
        ))
      }
    </div>
  </div>
  <div class="product-intro-content">
    <div class="product-intro-header">
      <h2 class="product-intro-title">{productName}</h2>
      {
        level && (
          <div class="product-intro-title-desc">
            <p>{level}</p>
            <span> Certified</span>
          </div>
        )
      }
    </div>
    <div class="product-intro-color">
      <p class="font-semibold">SIZES: {sizes?.join(", ")}</p>
      <p class="font-semibold">COLOR: BLACK</p>
      <div class="product-intro-color-pallete">
        {colors?.map((color) => <div style=`background-color: ${color.hex}` color-pallete />)}
      </div>
    </div>

    <div class="product-intro-desc">
      <h6>{productDesc}</h6>
    </div>
  </div>
</section>

<script></script>

<style>
  .product-intro-section {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    padding: 4rem 1rem;
    position: relative;
  }

  .product-intro-section::after {
    content: "";
    position: absolute;
    bottom: 0;
    left: 10%; /* (100% - 80%) / 2 = 10% from each side */
    width: 80%;
    height: 1.5px;
    background-color: #c4c6d0;
  }

  .product-intro-photo {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .product-intro-photo-main {
    display: flex;
    justify-content: center;
    align-items: center;
    /* aspect-ratio: 16/9; */
    border: 1.5px solid #c4c6d0;
  }

  .product-intro-photo-side > div{
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .product-intro-photo-main img {
    max-width: 60%;
    object-fit: cover;
  }

  .product-intro-photo-side {
    display: flex;
    gap: 1rem;
  }

  .product-intro-photo-side img {
    object-fit: cover;
  }

  .product-intro-photo-side > div {
    border: 1.5px solid #c4c6d0;
  }

  .product-intro-header {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding-bottom: 1.5rem;
  }

  .product-intro-title-desc > p {
    background-color: var(--color-black);
    display: inline-flex;
    font-size: 0.75rem;
    font-weight: bold;
    color: var(--color-white);
    padding: 0.25rem 0.75rem;
  }

  .product-intro-title-desc > span {
    font-size: 0.75rem;
    font-weight: bold;
    background-color: var(--color-white);
    color: #215fa5;
    padding: 0.25rem 0.5rem;
  }

  .product-intro-color {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding-bottom: 2rem;
  }

  .product-intro-color-pallete {
    display: flex;
    gap: 1rem;
  }

  .product-intro-color-pallete [color-pallete] {
    height: 40px;
    width: 40px;
    border-radius: 12px;
  }

  .product-intro-desc {
    padding: 0 0 0 1rem;
    border-left: 3px solid var(--secondary-500);
  }

  @media screen and (min-width: 768px) {
    .product-intro-section {
      padding: 3rem 3rem;
    }

    .product-intro-section::after {
      left: 5%;
      width: 90%;
    }
  }

  @media screen and (min-width: 1028px) {
    .product-intro-section {
      flex-direction: row;

      padding: 3rem 6rem;
    }

    .product-intro-section::after {
      left: 5%;
      width: 90%;
    }
    .product-intro-photo-main img {
      max-width: 50%;
    }

    .product-intro-photo-side img {
      max-width: 80%;
    }
    .product-intro-content {
      padding: 7.15rem 0;
    }
  }
</style>
