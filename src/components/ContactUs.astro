---
import CompanyBgImg from "@/assets/company/intro_bg.png";
import CompanyBg01Img from "@/assets/company/factory_01_bg.svg";
import ProductIntroSection from "@/components/ProductIntroSection.astro";
import ContactSection from "@/components/ContactSection.astro";

// Hero section data
const pageTitle = "Get In Touch";
const pageDescription =
  "Our team is here to provide expert assistance. Whether you are looking to place a bulk order or seeking tailored guidance, we are committed to delivering the support you need. Contact us today to discuss your specific requirements.";

// Contact section data
const ctaTitle = "Explore Our Solutions";
const ctaDescription =
  "We offer a wide range of ballistic protection products designed to meet the demands of military, law enforcement, security, and civilian applications. Whether you're seeking personal protection or armored vehicle solutions, our products provide the ultimate defense against ballistic threats.";
---

<!-- Introduction Section -->
<ProductIntroSection companyBgImg={CompanyBgImg} pageTitle={pageTitle} pageDescription={pageDescription} />

<!-- Form Section -->
<div class="form-section">
  <div class="form-container">
    <div class="form-title">
      <h3>Contact Us</h3>
    </div>
    <form id="contact-form" class="form-content" novalidate>
      <div class="field-row">
        <div class="input-container">
          <label class="form-label" for="name">Name <span class="required-mark" aria-hidden="true">*</span></label>
          <input
            type="text"
            id="name"
            name="name"
            placeholder="Input your name"
            required
            aria-required="true"
            autocomplete="name"
            aria-describedby="name-error"
          />
          <span id="name-error" class="field-error" role="alert" aria-live="polite"></span>
        </div>
        <div class="input-container">
          <label class="form-label" for="company">Company</label>
          <input
            type="text"
            id="company"
            name="company"
            placeholder="Input your company"
            autocomplete="organization"
            aria-describedby="company-error"
          />
          <span id="company-error" class="field-error" role="alert" aria-live="polite"></span>
        </div>
      </div>
      <div class="field-row">
        <div class="input-container">
          <label class="form-label" for="email">Email <span class="required-mark" aria-hidden="true">*</span></label>
          <input
            type="email"
            id="email"
            name="email"
            placeholder="Input your email"
            required
            aria-required="true"
            autocomplete="email"
            aria-describedby="email-error"
          />
          <span id="email-error" class="field-error" role="alert" aria-live="polite"></span>
        </div>
        <div class="input-container">
          <label class="form-label" for="phone">Phone Number</label>
          <input
            type="tel"
            id="phone"
            name="phone"
            placeholder="Input your phone number"
            autocomplete="tel"
            aria-describedby="phone-error"
          />
          <span id="phone-error" class="field-error" role="alert" aria-live="polite"></span>
        </div>
      </div>
      <div class="field-row">
        <div class="input-container">
          <label class="form-label" for="enquiry">Enquiry <span class="required-mark" aria-hidden="true">*</span></label>
          <textarea
            id="enquiry"
            name="enquiry"
            placeholder="Input your enquiry"
            rows="4"
            required
            aria-required="true"
            autocomplete="off"
            aria-describedby="enquiry-error"
          ></textarea>
          <span id="enquiry-error" class="field-error" role="alert" aria-live="polite"></span>
        </div>
      </div>
      <button type="submit" class="submit-btn"> Submit Your Enquiry </button>
    </form>
  </div>
</div>

<!-- Contact Section -->
<ContactSection
  bgImg={CompanyBg01Img}
  contactTitle={ctaTitle}
  contactDescription={ctaDescription}
  bgColor="primary-50"
  titleColor="primary-700"
  desColor="black"
/>

<script>
  const form = document.getElementById("contact-form") as HTMLFormElement | null;
  if (form) {
    const submitBtn = form.querySelector<HTMLButtonElement>('[type="submit"]');

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      let valid = true;

      form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>("[required]").forEach((input) => {
        const error = document.getElementById(input.id + "-error");
        if (!input.validity.valid) {
          valid = false;
          if (error) error.textContent = input.validationMessage;
          input.setAttribute("aria-invalid", "true");
        } else {
          if (error) error.textContent = "";
          input.removeAttribute("aria-invalid");
        }
      });

      if (!valid || !submitBtn) return;

      submitBtn.disabled = true;
      submitBtn.textContent = "Sending…";

      // Replace the timeout below with an actual fetch() when a backend is wired up
      await new Promise((r) => setTimeout(r, 1000));

      submitBtn.textContent = "Sent! We'll be in touch.";
      submitBtn.classList.add("btn-sent");
    });

    // Clear per-field error on input
    form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>("input, textarea").forEach((input) => {
      input.addEventListener("input", () => {
        const error = document.getElementById(input.id + "-error");
        if (input.validity.valid) {
          if (error) error.textContent = "";
          input.removeAttribute("aria-invalid");
        }
      });
    });
  }
</script>

<style>
  .form-section {
    padding: 3.125rem 1.25rem;
  }

  .form-container {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 3rem;
  }

  .form-title {
    color: var(--primary-900);
    padding-right: 2rem;
  }

  .form-content {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .field-row {
    display: flex;
    flex-direction: column;
    gap: 1.375rem;
  }

  .input-container {
    display: flex;
    flex-direction: column;
    width: 100%;
  }

  label {
    margin-bottom: 0.5rem;
    display: block;
  }

  .form-label {
    font-family: var(--font-hanken);
    font-weight: 700;
    font-size: 1.125rem;
  }

  @media only screen and (min-width: 768px) {
    .form-label { font-size: 1.25rem; }
  }

  @media only screen and (min-width: 1024px) {
    .form-label { font-size: 1.375rem; }
  }

  .required-mark {
    color: var(--error);
    margin-left: 0.2rem;
  }

  input[type="text"],
  input[type="email"],
  input[type="tel"],
  textarea {
    padding: 0.625rem 1.375rem;
    border: 1px solid var(--primary-500);
    border-radius: 5px;
    outline: none;
    transition: border-color 0.3s ease, box-shadow 0.3s ease;
    background: var(--gray);
    font-family: var(--font-hanken);
    font-size: 1rem;
  }

  textarea {
    resize: vertical;
    min-height: 6rem;
    width: 100%;
    margin-bottom: 2.25rem;
  }

  input[type="text"]:focus,
  input[type="email"]:focus,
  input[type="tel"]:focus,
  textarea:focus {
    border-color: var(--focus-ring);
    box-shadow: 0 0 5px rgba(0, 120, 215, 0.5);
  }

  input::placeholder,
  textarea::placeholder {
    color: var(--primary-100);
  }

  input[aria-invalid="true"],
  textarea[aria-invalid="true"] {
    border-color: var(--error);
  }

  input:valid:not(:placeholder-shown),
  textarea:valid:not(:placeholder-shown) {
    border-color: var(--secondary-500);
  }

  .field-error {
    display: block;
    min-height: 1.25rem;
    font-size: 0.875rem;
    color: var(--error);
    margin-top: 0.25rem;
  }

  .submit-btn {
    align-self: flex-start;
    font-family: var(--font-space);
    font-size: 1.5rem;
    padding: 0.75rem 1.5rem;
    background-color: var(--secondary-500);
    color: white;
    font-weight: 700;
    border: none;
    border-radius: 0.125rem;
    cursor: pointer;
    transition: opacity 0.2s ease, transform 0.1s ease, background-color 0.3s ease;
  }

  .submit-btn:hover {
    opacity: 0.9;
  }

  .submit-btn:active {
    transform: scale(0.97);
  }

  .submit-btn:disabled {
    opacity: 0.65;
    cursor: not-allowed;
    transform: none;
  }

  .submit-btn.btn-sent {
    background-color: var(--primary-700);
  }

  /* Tablet and above (min-width) */
  @media only screen and (min-width: 768px) {
    .form-section {
      padding: 6.25rem;
    }

    .form-title {
      border-right: 3px solid var(--secondary-500);
    }

    .form-container {
      flex-direction: row;
      gap: 4rem;
    }

    .field-row {
      flex-direction: row;
    }

    .submit-btn {
      width: 285px;
    }
  }

  /* Desktop and above */
  @media only screen and (min-width: 1024px) {
    input[type="text"],
    input[type="email"],
    input[type="tel"] {
      width: 385px;
    }
  }
</style>

<script is:inline type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: "https://ch-paisarn.com/" },
    { "@type": "ListItem", position: 2, name: "Contact Us", item: "https://ch-paisarn.com/contact" },
  ],
})} />
