---
import CompanyBgImg from "@/assets/company/intro_bg.png";
import CompanyBg01Img from "@/assets/company/factory_01_bg.svg";
import ProductIntroSection from "@/components/ProductIntroSection.astro";
import ContactSection from "@/components/ContactSection.astro";

// Hero section data
const pageTitle = "Get In Touch";
const pageDescription =
  "Our team is here to provide expert assistance. Whether you are looking to place a bulk order or seeking tailored guidance, we are committed to delivering the support you need. Contact us today to discuss your specific requirements.";

// Contact section data
const ctaTitle = "Explore Our Solutions";
const ctaDescription =
  "We offer a wide range of ballistic protection products designed to meet the demands of military, law enforcement, security, and civilian applications. Whether you’re seeking personal protection or armored vehicle solutions, our products provide the ultimate defense against ballistic threats.";
---

<!-- Introduction Section -->
<ProductIntroSection companyBgImg={CompanyBgImg} pageTitle={pageTitle} pageDescription={pageDescription} />

<!-- Form Section -->
<div class="form-section">
  <div class="form-container">
    <div class="form-title">
      <h3 class="heading-h3">Contact Us</h3>
    </div>
    <div class="form-content">
      <div class="field-row">
        <div class="input-container">
          <label class="heading-h5" for="name">Name</label>
          <input type="text" id="name" placeholder="Input your name" />
        </div>
        <div class="input-container">
          <label class="heading-h5" for="company">Company</label>
          <input type="text" id="company" placeholder="Input your company" />
        </div>
      </div>
      <div class="field-row">
        <div class="input-container">
          <label class="heading-h5" for="email">Email</label>
          <input type="text" id="email" placeholder="Input your email" />
        </div>
        <div class="input-container">
          <label class="heading-h5" for="company">Phone Number</label>
          <input type="text" id="phone" placeholder="Input your phone number" />
        </div>
      </div>
      <div class="field-row">
        <div class="input-container">
          <label class="heading-h5" for="name">Enquiry</label>
          <input type="text" id="enquiry" placeholder="Input your enquiry" />
        </div>
      </div>
      <button class="bg-[#58bb90] text-white font-bold rounded-sm hover:opacity-90 transition-all"> Submit Your Enquiry </button>
    </div>
  </div>
</div>

<!-- Contact Section -->
<ContactSection
  bgImg={CompanyBg01Img}
  contactTitle={ctaTitle}
  contactDescription={ctaDescription}
  bgColor="primary-50"
  titleColor="primary-700"
  desColor="black"
/>

<style>
  .form-section {
    padding: 3.125rem 1.25rem;
  }

  .form-container {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 3rem;
  }

  .form-title {
    color: var(--primary-900);
    padding-right: 2rem;
  }

  .form-content {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .field-row {
    display: flex;
    flex-direction: column;
    gap: 1.375rem;
  }

  .input-container {
    display: flex;
    flex-direction: column;
    width: 100%;
  }

  label {
    margin-bottom: 0.5rem;
    display: block;
  }

  input[type="text"] {
    padding: 0.625rem 1.375rem;
    border: 1px solid var(--primary-500);
    border-radius: 5px;
    outline: none;
    transition: border-color 0.3s ease;
    background: var(--gray);
  }

  input#enquiry {
    width: 100%;
    margin-bottom: 2.25rem;
  }

  input[type="text"]:focus {
    border-color: #0078d7;
    box-shadow: 0 0 5px rgba(0, 120, 215, 0.5);
  }

  input[type="text"]::placeholder {
    color: var(--primary-100);
  }

  button {
    align-self: flex-start;
    font-family: "Space Grotesk";
    font-size: 1.5rem;
    padding: 0.75rem 1.5rem;
  }

  /* Tablet and above (min-width) */
  @media only screen and (min-width: 768px) {
    .form-section {
      padding: 6.25rem;
    }

    .form-title {
      border-right: 3px solid var(--secondary-500);
    }

    .form-container {
      flex-direction: row;
      gap: 4rem;
    }

    .field-row {
      flex-direction: row;
    }

    button {
      width: 285px;
    }
  }

  /* Desktop and above */
  @media only screen and (min-width: 1024px) {
    input[type="text"] {
      width: 385px;
      padding: 0.625rem 1.375rem;
      border: 1px solid var(--primary-500);
      border-radius: 5px;
      outline: none;
      transition: border-color 0.3s ease;
      background: var(--gray);
    }
  }
</style>
