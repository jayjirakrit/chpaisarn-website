---
const customizeTitle: string = Astro.props.customizeTitle;
const customizeDescription: string = Astro.props.customizeDescription;
const customizationSteps: any[] = Astro.props.customizationSteps;
---

<section class="customize-section">
  <div class="customize-header">
    <h2 class="customize-title">{customizeTitle}</h2>
    <p class="customize-description">{customizeDescription}</p>
  </div>

  <!-- Customization Steps -->
  <div class="customize-container">
    {
      customizationSteps.map((step, index) => (
        <div class="step-wrapper reveal" style={`transition-delay: ${index * 100}ms`}>
          <img src={step.image} alt={step.title} class="step-image" />
          <div class="customize-step">
            <div class="step-header">
              <p class="step-label">{step.step}</p>
              <h3 class="step-title">{step.title}</h3>
            </div>
            <div class="step-content">
              {step.items ? (
                <div class="step-items">
                  {step.items.map((item) => (
                    <div>
                      <p class="step-item-title">{item.name}</p>
                      <p set:html={item.desc} class="step-item-desc" />
                    </div>
                  ))}
                </div>
              ) : (
                <p class="step-item-desc">{step.content}</p>
              )}
            </div>
          </div>
        </div>
      ))
    }
  </div>
</section>

<style>
  .customize-section {
    background-color: var(--primary-900);
    padding: 3.75rem 1.25rem;
  }

  .customize-header {
    margin-bottom: 3rem;
  }

  .customize-title {
    font-size: 3.5rem;
    color: white;
    margin-bottom: 1.5rem;
  }

  .customize-description {
    color: white;
    margin-bottom: 2rem;
    font-family: var(--font-hanken);
    font-size: 1rem;
  }

  @media only screen and (min-width: 768px) {
    .customize-description { font-size: 1.125rem; }
  }

  @media only screen and (min-width: 1024px) {
    .customize-description { font-size: 1.125rem; }
  }
  .customize-container {
    display: flex;
    flex-direction: column;
    /* gap: 3.5rem; */
    gap: 2.25rem;
  }
  .customize-step {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    margin-bottom: 1.5rem;
  }

  .step-wrapper {
    width: 100%;
  }

  .step-image {
    display: block;
    width: 100%;
    height: 16rem;
    border-radius: 0.5rem;
    object-fit: cover;
    margin-bottom: 2rem;
  }

  .step-content {
    flex: 1;
  }

  .step-header {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .step-label {
    font-family: var(--font-hanken);
    font-weight: 700;
    font-size: 1rem;
    color: white;
    padding-bottom: 0.75rem;
    border-bottom: 3px solid var(--accent);
    align-self: flex-start;
  }

  .step-title {
    font-family: var(--font-hanken);
    font-weight: 700;
    font-size: 1.75rem;
    color: white;
  }

  .step-items {
    display: grid;
    grid-template-columns: repeat(1, 1fr);
    gap: 1.5rem;
  }

  .step-item-title {
    font-weight: 700;
    font-size: 1.375rem;
    color: white;
    margin-bottom: 0.5rem;
  }

  .step-item-desc {
    color: white;
    line-height: 1.4;
  }

  /* Tablet and above (min-width) */
  @media only screen and (min-width: 768px) {
    .customize-section {
      padding: 5rem 6.25rem;
    }

    .customize-header {
      text-align: left;
      margin-bottom: 4rem;
    }

    .customize-container {
      gap: 3.5rem;
    }

    .customize-step {
      flex-direction: row;
      gap: 2.25rem;
    }

    .step-image {
      height: auto;
    }
    .step-header {
      flex: 1;
      padding-right: 1.5rem;
      border-right: 3px solid var(--accent);
    }

    .step-content {
      flex: 4;
    }

    .step-items {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 2rem;
    }
  }

</style>
