---
const optionsNav: { label: string; anchor: string }[] = Astro.props.optionsNav;
---

<div class="options-nav">
  {optionsNav.map((navItem) => (
    <a href={`#${navItem.anchor}`} class="options-nav-item body-text">{navItem.label}</a>
  ))}
</div>

<style>
  .options-nav {
    background-color: var(--primary-900);
    padding: 1.25rem 4rem;

    /* Mobile default – 2 column grid */
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    justify-items: center;
    align-items: center;
  }

  /* Odd number of items: last one spans both columns and centres */
  a.options-nav-item:last-child:nth-child(odd) {
    grid-column: span 2;
    justify-self: center;
  }

  a.options-nav-item {
    color: white;
    margin: 0;
    font-family: var(--font-hanken);
    font-weight: 400;
    white-space: nowrap;
    text-decoration: none;
    transition: width 0.3s ease-in-out;
  }

  a.options-nav-item:hover {
    color: var(--secondary-500);
  }

  /* Tablet and above (min-width) */
  @media only screen and (min-width: 768px) {
    .options-nav {
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 1.25rem;
    }
  }

</style>
