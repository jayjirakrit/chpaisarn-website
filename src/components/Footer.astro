---
import LogoImg from "../assets/logo_chp.webp";

const officeInfo = {
  address: "55/20 Soi Ronnasittipichai Sanambinnam Road Tasai Muang Nonthaburi 11000 Thailand",
  phone: "+662 580 2552 - 3",
  email: "contact@chpaisarn.com",
  email2: "natty@chpaisarn.com",
};

const factoryInfo = {
  address: "179 Moo11 Banchian Hunka Chainat 17130 Thailand",
  phone: "+665 645 1982 - 6",
};

const products = ["Body Armors", "Ballistic Helmets", "Ballistic Plates", "Other Ballistic Solutions", "Customized Defense Solutions"];

const company = ["About Us", "Quality", "Contact Us"];
---

<footer class="bg-white">
  <!-- Gradient bar -->
  <div class="h-2.5 bg-linear-to-r from-[#194577] to-[#8fb9e8]"></div>

  <!-- Main footer content -->
  <div class="mx-auto px-8 py-16">
    <div class="grid grid-cols-1 md:grid-cols-5 gap-12">
      <!-- Logo & Copyright -->
      <div class="flex flex-col gap-5">
        <img src={LogoImg.src} alt="Ch.Paisarn Logo" class="h-20 w-1/3 sm:h-30 sm:w-auto" />
        <p class="text-[#272727] text-[12px] font-hanken font-normal">© 2026 Ch.Paisarn. All Rights Reserved.</p>
        <p class="text-[#272727] text-[12px] font-hanken font-normal">Website created by House of Bandan</p>
      </div>

      <!-- Contact Section -->
      <div class="flex flex-col gap-7">
        <h3 class="text-[#2465AE] font-hanken text-[21px] font-bold">Contact Us</h3>
        <div class="flex flex-col gap-5 text-[#272727] text-[16px] font-hanken">
          <!-- Office -->
          <div>
            <p class="font-medium mb-2">Office</p>
            <p class="text-[16px] font-normal leading-relaxed">
              {officeInfo.address}
            </p>
          </div>
          <div class="flex gap-2">
            <span class="font-medium">📞</span>
            <p>{officeInfo.phone}</p>
          </div>
          <div class="flex gap-2">
            <span class="font-medium">✉️</span>
            <p>{officeInfo.email}</p>
          </div>
          <div class="flex gap-2">
            <span class="font-medium">✉️</span>
            <p>{officeInfo.email2}</p>
          </div>
        </div>
      </div>

      <!-- Factory -->
      <div class="flex flex-col gap-7">
        <h3 class="text-white font-hanken text-[21px] font-bold">Factory</h3>
        <div class="flex flex-col gap-5 text-[#272727] text-[16px] font-hanken font-normal">
          <div>
            <p class="font-medium mb-2">Factory</p>
            <p class="text-[16px] font-normal leading-relaxed">
              {factoryInfo.address}
            </p>
          </div>
          <div class="flex gap-2">
            <span class="font-medium">📞</span>
            <p>{factoryInfo.phone}</p>
          </div>
        </div>
      </div>

      <!-- Products Links -->
      <div class="flex flex-col gap-7">
        <h3 class="text-[#2465AE] font-hanken text-[21px] font-bold">Products</h3>
        <ul class="flex flex-col gap-5 text-[#272727] text-[16px] font-hanken font-normal">
          {
            products.map((product) => (
              <li>
                <a href="#" class="hover:text-[#2465AE] transition-colors">
                  {product}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Company Links -->
      <div class="flex flex-col gap-7">
        <h3 class="text-[#2465AE] font-hanken text-[21px] font-bold">Company</h3>
        <ul class="flex flex-col gap-5 text-[#272727] text-[16px] font-hanken font-normal">
          {
            company.map((item) => (
              <li>
                <a href="#" class="hover:text-[#2465AE] transition-colors">
                  {item}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</footer>
