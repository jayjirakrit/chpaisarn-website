---
import LogoImg from "@/assets/logo_chp.png";
import type { Lang } from "@/i18n/types";
import { useTranslations } from "@/i18n/utils";
import { Image } from "astro:assets";

interface Props {
  lang?: Lang;
}

const { lang = "en" } = Astro.props;
const t = useTranslations(lang);

const officeInfo = {
  address: "55/20 Soi Ronnasittipichai Sanambinnam Road Tasai Muang Nonthaburi 11000 Thailand",
  phone: "+662 580 2552 - 3",
  email: "contact@chpaisarn.com",
  email2: "natty@chpaisarn.com",
};

const factoryInfo = {
  address: "179 Moo11 Banchian Hunka Chainat 17130 Thailand",
  phone: "+665 645 1982 - 6",
};
---

<footer class="footer">
  <div class="footer-bar"></div>

  <div class="footer-inner">
    <div class="footer-grid">

      <!-- Logo & Copyright -->
      <div class="footer-brand">
        <Image src={LogoImg} alt="Ch.Paisarn Logo" class="footer-logo" />
        <p class="footer-copy footer-copy-desktop">{t("footer.copyright")}</p>
        <p class="footer-copy footer-copy-desktop">{t("footer.credit")}</p>
      </div>

      <!-- Contact group: spans both contact cols on mobile -->
      <div class="footer-contact-wrapper">
        <h3 class="footer-heading footer-group-heading">{t("footer.contactUs")}</h3>

        <!-- Office -->
        <div class="footer-col">
          <h3 class="footer-heading footer-col-heading">{t("footer.contactUs")}</h3>
          <div class="footer-contact-list">
            <div class="footer-contact-block">
              <p class="footer-label">{t("footer.office")}</p>
              <p class="footer-text">{t("footer.office.address")}</p>
            </div>
            <div class="footer-contact-row">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12 19.79 19.79 0 0 1 1.61 3.18 2 2 0 0 1 3.6 1h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 8.61A16 16 0 0 0 15.39 16.09l.96-.96a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
              <p class="footer-text">{t("footer.office.phone")}</p>
            </div>
            <div class="footer-contact-row">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
              <p class="footer-text">{t("footer.office.email")}</p>
            </div>
            <div class="footer-contact-row">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
              <p class="footer-text">{t("footer.office.email2")}</p>
            </div>
          </div>
        </div>

        <!-- Factory -->
        <div class="footer-col">
          <h3 class="footer-heading footer-col-heading">{t("footer.factory")}</h3>
          <div class="footer-contact-list">
            <div class="footer-contact-block">
              <p class="footer-label">{t("footer.factory")}</p>
              <p class="footer-text">{t("footer.factory.address")}</p>
              <p class="footer-text">{t("footer.factory.phone")}</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Nav group: 2-col grid on mobile -->
      <div class="footer-nav-wrapper">
        <!-- Products Links -->
        <div class="footer-col">
          <h3 class="footer-heading">{t("footer.products")}</h3>
          <ul class="footer-links">
            {t("footer.products.list").map((product) => (
              <li><a href="#" class="footer-link">{product}</a></li>
            ))}
          </ul>
        </div>

        <!-- Company Links -->
        <div class="footer-col">
          <h3 class="footer-heading">{t("footer.company")}</h3>
          <ul class="footer-links">
            {t("footer.company.list").map((item) => (
              <li><a href="#" class="footer-link">{item}</a></li>
            ))}
          </ul>
        </div>
      </div>

      <!-- Copyright: bottom on mobile, under logo on desktop -->
      <div class="footer-bottom">
        <p class="footer-copy">{t("footer.copyright")}</p>
        <p class="footer-copy">{t("footer.credit")}</p>
      </div>

    </div>
  </div>
</footer>

<style>
  /* ── Shell ─────────────────────────────────────────────────────────────────── */
  .footer {
    background-color: white;
  }

  .footer-bar {
    height: 0.625rem;
    background: linear-gradient(to right, var(--primary-700), var(--primary-100));
  }

  .footer-inner {
    max-width: 90rem;
    margin: 0 auto;
    padding: 3rem 1.5rem;
  }

  .footer-grid {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  /* ── Brand Column ───────────────────────────────────────────────────────────── */
  .footer-brand {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .footer-logo {
    width: 8rem;
    height: auto;
    object-fit: contain;
  }

  /* Desktop copyright (inside brand) hidden on mobile */
  .footer-copy-desktop {
    display: none;
  }

  .footer-copy {
    font-family: var(--font-hanken);
    font-size: 0.75rem;
    font-weight: 400;
    color: var(--black);
    line-height: 1.5;
  }

  /* ── Mobile: Contact wrapper — "Contact Us" heading + 2-col grid ─────────────── */
  .footer-contact-wrapper {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem 1.5rem;
  }

  /* Group heading spans both contact columns */
  .footer-group-heading {
    grid-column: 1 / -1;
  }

  /* Per-column headings hidden on mobile (group heading takes over) */
  .footer-col-heading {
    display: none;
  }

  /* ── Mobile: Nav wrapper — 2-col grid ──────────────────────────────────────── */
  .footer-nav-wrapper {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
  }

  /* ── Copyright at bottom on mobile ─────────────────────────────────────────── */
  .footer-bottom {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  /* ── Content Columns ───────────────────────────────────────────────────────── */
  .footer-col {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .footer-heading {
    font-family: var(--font-hanken);
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--primary-500);
  }

  /* ── Contact Blocks ─────────────────────────────────────────────────────────── */
  .footer-contact-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .footer-contact-block {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }

  .footer-contact-row {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    color: var(--black);
  }

  .footer-contact-row svg {
    flex-shrink: 0;
    margin-top: 0.2rem;
    color: var(--primary-500);
  }

  .footer-label {
    font-family: var(--font-hanken);
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--black);
  }

  .footer-text {
    font-family: var(--font-hanken);
    font-size: 0.875rem;
    font-weight: 400;
    color: var(--black);
    line-height: 1.6;
  }

  /* ── Nav Links ──────────────────────────────────────────────────────────────── */
  .footer-links {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .footer-link {
    font-family: var(--font-hanken);
    font-size: 0.875rem;
    font-weight: 400;
    color: var(--black);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .footer-link:hover {
    color: var(--primary-500);
  }

  /* ── Tablet and above ───────────────────────────────────────────────────────── */
  @media only screen and (min-width: 768px) {
    .footer-inner {
      padding: 4rem 3rem;
    }

    /* Switch to 5-col grid; brand in col 1, copyright below brand */
    .footer-grid {
      display: grid;
      grid-template-columns: 1fr 1.6fr 1fr 1fr 1fr;
      grid-template-rows: 1fr auto;
      gap: 3rem;
      align-items: start;
    }

    .footer-brand {
      grid-column: 1;
      grid-row: 1;
    }

    /* Wrappers dissolve — children become direct grid children */
    .footer-contact-wrapper,
    .footer-nav-wrapper {
      display: contents;
    }

    /* Mobile copyright hidden; desktop copyright (inside brand) shown */
    .footer-bottom {
      display: none;
    }

    .footer-copy-desktop {
      display: block;
    }

    /* Hide mobile group heading; show per-column headings */
    .footer-group-heading {
      display: none;
    }

    .footer-col-heading {
      display: block;
    }

    .footer-logo {
      width: 9rem;
    }
  }

  /* ── Desktop and above ──────────────────────────────────────────────────────── */
  @media only screen and (min-width: 1024px) {
    .footer-inner {
      padding: 5rem 6.25rem;
    }

    .footer-logo {
      width: 10rem;
    }
  }
</style>
