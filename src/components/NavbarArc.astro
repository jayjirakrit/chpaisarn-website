---
import LogoImg from "../assets/logo_chp.webp";

const navItems = [
  { name: "Home", link: "/", items: [{ name: "Home", link: "/", img: "" }] },
  {
    name: "Products",
    link: "/products",
    items: [
      { name: "Body Armors", link: "/products", img: "" },
      { name: "Ballistic Plates", link: "/products/ballistic-plates", img: "" },
      { name: "Ballistic Helmets", link: "/products/ballistic-helmets", img: "" },
      { name: "Other Ballistic Solutions", link: "/products/other-solutions", img: "" },
      { name: "Customized Defense Solutions", link: "/products/customized-solutions", img: "" },
    ],
  },
  {
    name: "About Us",
    link: "/company",
    items: [
      { name: "Our Company", link: "/company", img: "" },
      { name: "Quality Standards", link: "/quality-standards", img: "" },
    ],
  },
  { name: "Contact Us", link: "/contact", items: [{ name: "Contact Us", link: "/contact", img: "" }] },
];

const languages = [
  { code: "en", name: "English" },
  { code: "th", name: "ไทย" },
];
const currentPath = Astro.url.pathname;
---

<nav class="sticky top-0 right-0 left-0 z-50 bg-white shadow-md">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-24">
      <!-- Logo -->
      <div class="shrink-0">
        <img src={LogoImg.src} alt="Ch.Paisarn Logo" class="h-20 w-auto" />
      </div>

      <!-- Desktop Menu -->
      <div class="hidden lg:flex flex-col gap-3">
        <!-- Language Selector -->
        <div class="flex justify-end gap-5 text-sm">
          {
            languages.map((lang) => (
              <a href="#" class="font-hanken text-[16px] font-normal text-[#14375F] hover:text-[#2465AE] transition-colors">
                {lang.name}
              </a>
            ))
          }
        </div>

        <!-- Navigation Items -->
        <div class="font-hanken flex gap-8 items-center">
          {
            navItems.map((item, index) => {
              return (
                <div id={`${index}`} class="nav-bar-item relative z-20">
                  {/* relative container for absolute dropdown */}
                  <a
                    href={item.link}
                    class={`text-[21px] transition-colors ${
                      currentPath === item.link ? "font-bold text-[#14375F]" : "font-normal text-[#14375F] hover:text-[#2465AE]"
                    }`}
                  >
                    {item.name}
                  </a>
                  <div class={`dropdown-${index} bg-white fixed left-0 right-0 w-full top-24 hidden z-10`}>
                    <div class="dropdown-container">
                      <div class="dropdown-left flex flex-col p-5 gap-4">
                        {navItems?.map((dropItem, dropIndex) => {
                          return (
                            <a
                              href={dropItem.link}
                              class={`text-[21px] transition-colors ${
                                currentPath === dropItem.link ? "font-bold text-[#14375F]" : "font-normal text-[#14375F] hover:text-[#2465AE]"
                              }`}
                            >
                              {dropItem.name}
                            </a>
                          );
                        })}
                      </div>
                      <div class="dropdown-right flex flex-col bg-white p-5 gap-4">
                        {item?.items?.map((subItem) => (
                          <a
                            href={subItem.link}
                            class="text-[21px] font-normal text-[#14375F] hover:text-[#2465AE] transition-colors whitespace-nowrap"
                          >
                            {subItem.name}
                          </a>
                        ))}
                      </div>
                    </div>
                  </div>
                </div>
              );
            })
          }
        </div>
      </div>

      <!-- Mobile Menu Button -->
      <div class="relative lg:hidden">
        <button id="mobile-menu-btn" class="p-2 z-20">
          <svg class="w-8 h-8 text-[#14375F]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
        </button>
        <div class="mobile-nav-container fixed top-0 right-0">
          <div class="flex flex-col gap-4 p-4 bg-white w-[33.333vw] min-w-[200px]">
            <button id="close-menu-btn" class="flex justify-end p-2">
              <svg class="w-6 h-6 text-[#14375F]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
              </svg>
            </button>
            {
              navItems.map((item) => (
                <a
                  href={item.link}
                  class={`text-[21px] whitespace-nowrap transition-colors ${
                    currentPath === item.link ? "font-bold text-[#14375F]" : "font-normal text-[#14375F] hover:text-[#2465AE]"
                  }`}
                >
                  {item.name}
                </a>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </div>

  <style>
    nav {
      box-shadow: 0px 3px 2.5px rgba(0, 0, 0, 0.15);
    }

    .mobile-nav-container {
      display: none;
    }

    .mobile-toggle-open {
      display: flex;
    }

    .dropdown-container {
      display: flex;
      justify-content: center;
      gap: 2rem;
      padding: 1rem 0;
    }
    @media (max-width: 1024px) {
      nav .desktop-nav {
        display: none;
      }
    }
  </style>

  <script>
    import $ from "jquery";

    const navItems = $(".nav-bar-item");
    const mobileMenuBtn = $("#mobile-menu-btn");
    const closeMenuBtn = $("#close-menu-btn");
    const mobileNav = $(".mobile-nav-container");

    mobileMenuBtn?.on("click", (e) => {
      e.preventDefault();
      mobileNav?.toggleClass("mobile-toggle-open");
    });
    closeMenuBtn?.on("click", (e) => {
      e.preventDefault();
      mobileNav?.removeClass("mobile-toggle-open");
    });
    navItems?.on("mouseenter", (e) => {
      const index = $(e.currentTarget).attr("id");
      $(`.dropdown-${index}`).removeClass("hidden");
    });
    navItems?.on("mouseleave", (e) => {
      const index = $(e.currentTarget).attr("id");
      $(`.dropdown-${index}`).addClass("hidden");
    });
  </script>
</nav>
