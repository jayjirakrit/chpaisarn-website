---
import LogoImg from "../assets/logo_chp.webp";

type Card = {
  title: string;
  description: string;
  image: string;
  link: string;
  accent?: boolean;
};

type MegaMenu = {
  layout: "single" | "two" | "products";
  cards: Card[];
};

const navItems = [
  { name: "Home", link: "/", key: "home" },
  { name: "Products", link: "/products", key: "products" },
  { name: "About Us", link: "/#about", key: "about" },
  { name: "Contact Us", link: "/contact", key: "contact" },
];

const languages = [
  { code: "en", name: "English" },
  { code: "th", name: "ไทย" },
];

const ARMOR_IMG = "/images/navbar/nav_armor.png";
const CUSTOMIZE_IMG = "/images/navbar/nav_customize.png";
const HELMET_IMG = "/images/navbar/nav_helmet.png";
const PLATE_IMG = "/images/navbar/nav_plate.png";
const OTHER_IMG = "/images/navbar/nav_other.png";
const currentPath = Astro.url.pathname;

const megaMenus: Record<string, MegaMenu> = {
  home: {
    layout: "single",
    cards: [
      {
        title: "Homepage",
        description:
          "Leading the industry through innovative engineering and rigorous international standards. We specialize in custom-tailored ballistic solutions and individual equipment, ensuring uncompromising safety for those on the front lines.",
        image: "/images/navbar/home-card.png",
        link: "/",
      },
    ],
  },
  products: {
    layout: "products",
    cards: [
      {
        title: "Body Armors",
        description:
          "Our Body Armors provide cutting-edge protection across three main categories, ensuring comprehensive safety for law enforcement, military, and security personnel. Whether you're facing bullets, knives, spikes, or a combination of both, we offer the flexibility to tailor your protection.",
        image: ARMOR_IMG,
        link: "/products",
      },
      {
        title: "Ballistic Helmets",
        description:
          "Engineered from advanced materials to provide high-impact defense against ballistic threats and blunt trauma without sacrificing mobility. These lightweight, durable helmets are fully customizable in shape and specification to meet unique operational or environmental demands.",
        image: HELMET_IMG,
        link: "/products/ballistic-helmets",
      },
      {
        title: "Ballistic Plates",
        description:
          "Our ballistic plates provide customizable solutions for personal protection. With options ranging from Level III to Level IV, each plate is tested for performance and durability to protect against high-velocity rounds.",
        image: PLATE_IMG,
        link: "/products/ballistic-plates",
      },
    ],
  },
  about: {
    layout: "two",
    cards: [
      {
        title: "Our Company",
        description:
          "50 years of experience. 100% in-house design, manufacturing, and testing. Thailand's largest ballistic protection manufacturer.",
        image: "/images/navbar/about-company.png",
        link: "/",
      },
      {
        title: "Quality Standards",
        description:
          "At Ch. Paisarn, we combine rigorous international testing with advanced engineering to ensure every piece of equipment provides dependable protection. Explore our commitment to excellence through our certified processes and precision manufacturing.",
        image: "/images/navbar/about-quality.png",
        link: "/",
        accent: true,
      },
    ],
  },
  contact: {
    layout: "single",
    cards: [
      {
        title: "Get In Touch",
        description:
          "Our team is here to provide expert assistance. Whether you are looking to place a bulk order or seeking tailored guidance, we are committed to delivering the support you need. Contact us today to discuss your specific requirements.",
        image: "/images/navbar/contact-card.png",
        link: "/contact",
      },
    ],
  },
};

const isPathActive = (link: string) => currentPath === link || (link !== "/" && currentPath.startsWith(link));

const GLOBE_PATH =
  "M16 2C8.268 2 2 8.268 2 16s6.268 14 14 14 14-6.268 14-14S23.732 2 16 2zm9.542 8.667h-4.198c-.412-2.016-1.064-3.771-1.896-5.097a11.37 11.37 0 0 1 6.094 5.097zM16 4.04c1.147 1.19 2.084 3.157 2.631 5.627h-5.262C13.916 7.197 14.853 5.23 16 4.04zM4.318 18.667A11.618 11.618 0 0 1 4 16c0-.9.107-1.774.318-2.667h4.814A23.94 23.94 0 0 0 9 16c0 .9.053 1.787.132 2.667H4.318zm.14 2h4.198c.412 2.016 1.064 3.771 1.896 5.097a11.37 11.37 0 0 1-6.094-5.097zm4.198-10.667H4.458a11.37 11.37 0 0 1 6.094-5.097c-.832 1.326-1.484 3.081-1.896 5.097zM16 27.96c-1.147-1.19-2.084-3.157-2.631-5.627h5.262C18.084 24.803 17.147 26.77 16 27.96zm3.208-7.627h-6.416A21.764 21.764 0 0 1 12.667 16c0-.921.047-1.81.125-2.667h6.416c.078.857.125 1.746.125 2.667s-.047 1.81-.125 2.667h.001zm.24 7.764c.832-1.326 1.484-3.081 1.896-5.097h4.198a11.37 11.37 0 0 1-6.094 5.097zm2.42-7.097A25.894 25.894 0 0 0 22 16a25.894 25.894 0 0 0-.132-2.667h4.814C26.893 14.226 27 15.1 27 16s-.107 1.774-.318 2.667h-4.814z";
---

<nav class="navbar" aria-label="Main navigation">
  <div class="navbar-main">
    <div class="navbar-container">
      <div class="navbar-inner">
        <a href="/" class="navbar-logo">
          <img src={LogoImg.src} alt="Ch.Paisarn Logo" />
        </a>

        <div class="navbar-desktop">
          <div class="navbar-nav-items">
            {
              navItems.map((item) => (
                <div class="nav-item" data-menu={item.key}>
                  <a href={item.link} class:list={["nav-link", { "is-active": isPathActive(item.link) }]}>
                    {item.name}
                  </a>
                </div>
              ))
            }
          </div>

          <div class="lang-group" role="group" aria-label="Language selection">
            <svg class="lang-icon" width="32" height="32" viewBox="0 0 32 32" fill="currentColor" aria-hidden="true"><path d={GLOBE_PATH}></path></svg>
            <div class="lang-list">
              {
                languages.map((lang, i) => (
                  <a href="#" class:list={["lang-link", { "is-active": i === 0 }]}>
                    {lang.name}
                  </a>
                ))
              }
            </div>
          </div>
        </div>

        <div class="navbar-mobile">
          <button id="mobile-menu-btn" class="mobile-icon-btn" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-nav-panel">
            <svg width="32" height="32" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
            </svg>
          </button>
          <button id="close-menu-btn" class="mobile-icon-btn mobile-close-btn is-close" aria-label="Close menu">
            <svg width="24" height="24" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
            </svg>
          </button>
          <!-- mobile panel moved out of here -->
        </div>
      </div>
    </div>
  </div>

  <div class="navbar-accent-bar"></div>

  <!-- Mobile panel now in normal flow, directly after accent bar -->
  <div class="mobile-nav-container" id="mobile-nav-panel">
    <div class="mobile-nav-panel">
      {
        navItems.map((item, index) => (
          <div class="mobile-nav-link" data-menu={item.key}>
            <div class="mobile-nav-link-parent">
              <a href={item.link} class:list={["font-bold", { "is-active": currentPath === item.link }]}>
                {item.name}
              </a>
              <button type="button" aria-expanded="false" aria-controls={`mobile-nav-link-child-${index}`}>
                <svg width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                  <path d="M0 6.71H8.09L4.79 10L6.21 11.42L11.91 5.71L6.21 0L4.79 1.42L8.09 4.71H0V6.71Z" fill="#14375F" />
                </svg>
              </button>
            </div>

            <div id={`mobile-nav-link-child-${index}`} class="mobile-nav-link-child">
              {megaMenus[item.key as keyof typeof megaMenus]?.cards.map((card) => (
                <a href={card.link} class="mega-card mb-2.5">
                  <div class="flex flex-col gap-2">
                    <h6 class="font-bold">{card.title}</h6>
                    <p class="body-text text-black">{card.description}</p>
                  </div>
                </a>
              ))}
            </div>
          </div>
        ))
      }
      <div class="mobile-language">
        {
          languages.map((lang, i) => (
            <a href="#" class:list={["mobile-lang-link", { "is-active": i === 0 }]}>
              {lang.name}
            </a>
          ))
        }
      </div>
    </div>
  </div>

  {
    Object.entries(megaMenus).map(([key, menu]) => (
      <div id={`mega-menu-${key}`} class="mega-menu" role="region" aria-label={`${navItems.find(n => n.key === key)?.name ?? key} submenu`}>
        <div class="mega-menu-container">
          <div class="mega-menu-sidebar">
            <div class="mega-nav-items">
              {navItems.map((item) => (
                <a href={item.link} class:list={["mega-nav-link", { "is-active": item.key === key }]}>
                  {item.name}
                </a>
              ))}
            </div>
            <div class="lang-group mega-lang-group" role="group" aria-label="Language selection">
              <svg class="lang-icon" width="32" height="32" viewBox="0 0 32 32" fill="currentColor" aria-hidden="true">
                <path d={GLOBE_PATH} />
              </svg>
              <div class="lang-list">
                {languages.map((lang, i) => (
                  <a href="#" class:list={["lang-link", { "is-active": i === 0 }]}>
                    {lang.name}
                  </a>
                ))}
              </div>
            </div>
          </div>
          <div class={`mega-menu-content layout-${menu.layout}`}>
            {menu.cards.map((card) => (
              <a href={card.link} class="mega-card">
                <div class="mega-card-image">
                  <img src={card.image} alt={card.title} width="245" height="183" loading="lazy" decoding="async" />
                </div>
                <div class="mega-card-text">
                  <span class:list={["mega-card-title", { "is-accent": card.accent }]}>{card.title}</span>
                  <span class="mega-card-description">{card.description}</span>
                </div>
              </a>
            ))}
          </div>
        </div>
      </div>
    ))
  }

  <style>
    /* ── Shell ──────────────────────────────────────────────────────────────────── */
    .navbar {
      position: sticky;
      top: 0;
      z-index: 50;
      background-color: var(--white);
    }

    .navbar-main {
      box-shadow: 0 0.1875rem 0.3125rem 0 rgba(0, 0, 0, 0.15);
    }

    .navbar-container {
      max-width: 94.5rem;
      margin: 0 auto;
      padding: 0 1.5rem;
    }

    .navbar-inner {
      display: flex;
      align-items: center;
      justify-content: space-between;
      height: 5.625rem;
    }

    /* ── Logo ───────────────────────────────────────────────────────────────────── */
    .navbar-logo {
      flex-shrink: 0;
    }

    .navbar-logo img {
      height: 4.4375rem;
      width: auto;
    }

    /* ── Desktop Nav Links ──────────────────────────────────────────────────────── */
    .navbar-desktop {
      display: none;
    }

    .navbar-nav-items {
      display: flex;
      align-items: center;
      gap: 2rem;
      font-family: var(--font-hanken);
    }

    .nav-link,
    .lang-link,
    .mega-nav-link,
    .mobile-nav-link,
    .mobile-lang-link {
      font-weight: 400;
      color: var(--primary-900);
      text-decoration: none;
      transition: color 0.2s;
      white-space: nowrap;
    }

    /* Active underline indicator */
    .nav-link {
      position: relative;
    }

    .nav-link::after {
      content: "";
      position: absolute;
      bottom: -0.25rem;
      left: 0;
      width: 0;
      height: 0.1875rem;
      background-color: var(--secondary-500);
      transition: width 0.2s ease;
    }

    .nav-link.is-active::after,
    .nav-link:hover::after {
      width: 100%;
    }

    .nav-link,
    .lang-link {
      font-size: 1.3125rem;
    }

    .nav-link:hover,
    .lang-link:hover,
    .mega-nav-link:hover {
      color: var(--primary-500);
    }

    .nav-link.is-active,
    .lang-link.is-active,
    .mega-nav-link.is-active,
    .mobile-nav-link.is-active,
    .mobile-lang-link.is-active {
      font-weight: 700;
    }

    /* ── Language Selector ──────────────────────────────────────────────────────── */
    .lang-group {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      flex-shrink: 0;
    }

    .lang-icon {
      color: var(--primary-900);
    }

    .lang-list {
      display: flex;
      align-items: center;
      gap: 1.25rem;
    }

    .lang-link {
      font-family: var(--font-hanken);
    }

    /* ── Mobile Menu Toggle ─────────────────────────────────────────────────────── */
    .navbar-mobile {
      position: relative;
    }

    .mobile-icon-btn {
      padding: 0.5rem;
      background: none;
      border: none;
      color: var(--primary-900);
      cursor: pointer;
    }

    .mobile-icon-btn.is-close {
      display: none;
    }

    .mobile-close-btn {
      display: flex;
      justify-content: flex-end;
    }

    /* ── Mobile Nav Panel ───────────────────────────────────────────────────────── */
    .mobile-nav-container {
      max-height: 0;
      overflow: hidden;
      position: sticky;
      top: 0;
      z-index: 49; /* below navbar-main (z‑50) but above page content */
      width: 100%;
      background-color: var(--white);
      box-shadow: 0 0.625rem 0.9375rem -0.1875rem rgba(0, 0, 0, 0.1);
      transition: max-height 0.35s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .mobile-nav-container.is-open {
      max-height: 60rem;
    }

    .mobile-nav-panel {
      display: flex;
      flex-direction: column;
      width: 100%;
      min-width: 12.5rem;
      padding: 2rem 1.25rem;
    }

    .mobile-nav-link {
      display: flex;
      flex-direction: column;
      border-top: 1.5px solid var(--secondary-500);
    }

    .mobile-nav-link-parent {
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 1.3125rem;
      padding: 0.75rem 0;
    }

    /* Mobile accordion: animated height expand */
    .mobile-nav-link-child {
      max-height: 0;
      overflow: hidden;
      transition: max-height 0.3s ease;
    }

    .mobile-nav-link-child.is-expanded {
      max-height: 40rem;
    }

    /* Rotate arrow when expanded */
    .mobile-nav-link-parent button {
      transition: transform 0.3s ease;
      background: none;
      border: none;
      cursor: pointer;
      padding: 0.25rem;
    }

    .mobile-nav-link-parent button.active {
      transform: rotate(90deg);
    }

    .mobile-nav-link-child .mega-card p {
      display: -webkit-box;
      -webkit-line-clamp: 3;
      -webkit-box-orient: vertical;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: normal; /* ← override inherited nowrap */
      word-break: break-word;
      line-height: 1.4;
      max-height: calc(1.4em * 3);
    }

    .mobile-nav-link:first-child {
      border-top: none;
    }

    .mobile-language {
      display: flex;
      gap: 1.25rem;
      margin-top: 1rem;
      padding-top: 1rem;
      border-top: 0.0625rem solid var(--gray-light);
    }

    .mobile-lang-link {
      font-family: var(--font-hanken);
      font-size: 1rem;
    }

    /* ── Accent Bar ─────────────────────────────────────────────────────────────── */
    .navbar-accent-bar {
      height: 0.625rem;
      width: 100%;
      background: linear-gradient(90deg, rgba(25, 69, 119, 1) 8%, rgba(143, 185, 232, 1) 100%);
    }

    .mega-menu {
      position: absolute;
      left: 0;
      width: 100%;
      background-color: var(--white);
      z-index: 40;
      box-shadow: 0 0.375rem 1rem rgba(0, 0, 0, 0.15);
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
      transform: translateY(-0.5rem);
      transition: opacity 0.2s ease, visibility 0.2s ease, transform 0.2s ease;
    }

    .mega-menu.is-visible {
      opacity: 1;
      visibility: visible;
      pointer-events: auto;
      transform: translateY(0);
    }

    .mega-menu-container {
      max-width: 94.5rem;
      margin: 0 auto;
      padding: 3.125rem 1.5rem;
      display: flex;
      gap: 2.25rem;
    }

    .mega-menu-sidebar {
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      flex-shrink: 0;
      min-width: 13.75rem;
      border-right: 0.1875rem solid var(--secondary-500);
      padding-right: 2.25rem;
    }

    .mega-nav-items {
      display: flex;
      flex-direction: column;
      gap: 1.5rem;
    }

    .mega-nav-link {
      font-size: 1.75rem;
      line-height: 140%;
    }

    .mega-lang-group {
      margin-top: 2rem;
    }

    .mega-menu-content {
      flex: 1;
      display: grid;
      gap: 1.75rem;
    }

    .mega-menu-content.layout-two {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .mega-card {
      display: flex;
      flex-direction: column;
      gap: 1.5rem;
      border-radius: 0.625rem;
      overflow: hidden;
      text-decoration: none;
    }

    .layout-two .mega-card-image {
      height: 17.875rem;
    }

    .layout-single .mega-card-image {
      height: 12.25rem;
    }

    .mega-card-image img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      aspect-ratio: 245 / 183;
      transition: transform 0.3s;
    }

    .mega-card:hover .mega-card-image img {
      transform: scale(1.05);
    }

    .mega-card {
      transition: box-shadow 0.2s ease;
    }

    .mega-card-text {
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
    }

    .mega-card-title {
      font-size: 1.3125rem;
      font-weight: 700;
      line-height: 160%;
      color: var(--primary-900);
      transition: color 0.2s ease;
    }

    .mega-card:hover .mega-card-title {
      color: var(--primary-500);
    }

    .mega-card-title.is-accent {
      color: var(--secondary-700);
    }

    .mega-card-description {
      font-size: 1rem;
      line-height: 140%;
      color: var(--black);
      display: -webkit-box;
      -webkit-line-clamp: 3;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }

    .layout-single .mega-card-description {
      display: block;
      overflow: visible;
    }

    @media only screen and (min-width: 768px) {
      .navbar-container {
        padding: 1.25rem 4.6875rem;
      }

      .navbar-desktop {
        display: flex;
        align-items: center;
        gap: 3rem;
      }

      .navbar-mobile {
        display: none;
      }

      /* Still hide the mobile container on desktop */
      .mobile-nav-container {
        max-height: 0 !important;
        overflow: hidden !important;
      }

      .mega-menu-container {
        margin: 0 auto;
        padding: 3.5rem 4.6875rem;
        display: flex;
        gap: 1.75rem;
      }
      .mega-menu-content.layout-products {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }

      .mega-card-image {
        width: 100%;
        border-radius: 0.3125rem;
        overflow: hidden;
        height: 16rem;
      }
    }

    @media only screen and (min-width: 1024px) {
      .navbar-container {
        padding: 0 6.25rem;
      }

      .navbar-desktop {
        display: flex;
        align-items: center;
        gap: 3rem;
      }

      .navbar-mobile {
        display: none;
      }

      /* Still hide the mobile container on desktop */
      .mobile-nav-container {
        max-height: 0 !important;
        overflow: hidden !important;
      }

      .mega-menu-container {
        max-width: 94.5rem;
        margin: 0 auto;
        padding: 3.125rem 14rem;
        display: flex;
        gap: 1.75rem;
      }

      .mega-menu-content.layout-products {
        grid-template-columns: repeat(3, minmax(0, 1fr));
      }

      .mega-card-image {
        /* height: 14rem; */
      }
    }
  </style>

  <script>
    import $ from "jquery";

    let hideTimer: ReturnType<typeof setTimeout>;
    const $menus = $(".mega-menu");

    const show = ($menu: JQuery) => {
      clearTimeout(hideTimer);
      $menus.not($menu).removeClass("is-visible");
      $menu.addClass("is-visible");
    };

    const hide = ($menu: JQuery) => {
      hideTimer = setTimeout(() => $menu.removeClass("is-visible"), 80);
    };

    $(".nav-item[data-menu]").each(function () {
      const $menu = $(`#mega-menu-${$(this).data("menu")}`);
      if (!$menu.length) return;
      $(this)
        .add($menu)
        .on("mouseenter", () => show($menu))
        .on("mouseleave", () => hide($menu));
    });

    $(document).on("click", (e) => {
      if (!$(e.target as Element).closest(".nav-item, .mega-menu").length) {
        $menus.removeClass("is-visible");
      }
    });

    // Toggle the in‑flow mobile container
    const toggleMobileNav = () => {
      const $container = $(".mobile-nav-container");
      const isOpen = $container.hasClass("is-open");
      $container.toggleClass("is-open");
      $("#mobile-menu-btn").attr("aria-expanded", String(!isOpen));
    };

    $("#mobile-menu-btn").on("click", toggleMobileNav);
    $("#close-menu-btn").on("click", toggleMobileNav);

    // --- Mobile accordion for sub-menus ---
    $(".mobile-nav-link-parent button").on("click", function (e) {
      e.preventDefault();
      const $btn = $(this);
      const $parent = $btn.closest(".mobile-nav-link");
      const $child = $parent.find(".mobile-nav-link-child");
      const isActive = $btn.hasClass("active");

      // Close all other open children
      $(".mobile-nav-link-child").not($child).removeClass("is-expanded");
      $(".mobile-nav-link-parent button").not($btn).removeClass("active").attr("aria-expanded", "false");

      // Toggle current child and button state
      if (isActive) {
        $btn.removeClass("active").attr("aria-expanded", "false");
        $child.removeClass("is-expanded");
      } else {
        $btn.addClass("active").attr("aria-expanded", "true");
        $child.addClass("is-expanded");
      }
    });
  </script>
</nav>
