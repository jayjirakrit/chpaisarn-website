---
import CompanyBgImg from "@/assets/company/intro_bg.png";
import CompanyBgMobileImg from "@/assets/company/intro_bg_mobile.png";
import CompanyBg01Img from "@/assets/company/factory_01_bg.svg";
import Spec01Img from "@/assets/spec_01.png";
import Spec02Img from "@/assets/spec_02.png";
import Spec03Img from "@/assets/spec_03.png";
import Spec04Img from "@/assets/spec_04.png";
import Spec05Img from "@/assets/spec_08.png";
import Armor01Img from "@/assets/products/armor/armor_01.png";
import Armor02Img from "@/assets/products/armor/armor_02.png";
import Armor03Img from "@/assets/products/armor/armor_03.png";
import Armor04Img from "@/assets/products/armor/armor_04.png";
import Armor05Img from "@/assets/products/armor/armor_05.png";
import Armor06Img from "@/assets/products/armor/armor_06.png";
import Armor07Img from "@/assets/products/armor/armor_07.png";
import Armor08Img from "@/assets/products/armor/armor_08.png";
import Armor09Img from "@/assets/products/armor/armor_09.png";

import IntroSection from "@/components/IntroSection.astro";
import ProductOptionSection from "@/components/ProductOptionSection.astro";
import ProductOptionNav from "@/components/ProductOptionNav.astro";
import CustomStepsSection from "@/components/CustomStepsSection.astro";
import ContactSection from "@/components/ContactSection.astro";
import ProductOpItemsSection from "@/components/ProductOpItemsSection.astro";
import type { Lang } from "@/i18n/types";
import { useTranslations, breadcrumbUrl } from "@/i18n/utils";

interface Props {
  lang?: Lang;
}

const { lang = "en" } = Astro.props;
const t = useTranslations(lang);

const breadcrumbLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: lang === "th" ? "หน้าแรก" : "Home", item: breadcrumbUrl(lang, "/") },
    { "@type": "ListItem", position: 2, name: lang === "th" ? "สินค้า" : "Products", item: breadcrumbUrl(lang, "/products") },
  ],
};

const armorImgs = [Armor05Img, Armor06Img, Armor07Img, Armor08Img, Armor09Img, Armor04Img, Armor01Img, Armor02Img, Armor03Img];
const stepImgs = [Spec01Img.src, Spec02Img.src, Spec03Img.src, Spec04Img.src, Spec05Img.src];

const itemOptions = t("armour.itemOptions").map((opt, i) => ({ ...opt, img: armorImgs[i] }));
const customizationSteps = t("armour.customizationSteps").map((step, i) => ({ ...step, image: stepImgs[i] }));
---

<!-- Hero Section -->
<IntroSection companyBgImg={CompanyBgImg} companyBgImgMobile={CompanyBgMobileImg} pageTitle={t("armour.hero.title")} pageDescription={t("armour.hero.description")} />

<!--Options Navigation -->
<ProductOptionNav optionsNav={t("armour.optionsNav")} />

<!-- Your Item Options Section -->
<div id="your-options">
  <ProductOpItemsSection optionsTitle={t("armour.optionsItem.title")} optionsDescription={t("armour.optionsItem.description")} itemOptions={itemOptions} />
</div>

<!-- Your Options Section -->
<div id="protection-systems">
  <ProductOptionSection optionsTitle={t("armour.options.title")} optionsDescription={t("armour.options.description")} protectionOptions={t("armour.protectionOptions")} />
</div>

<!-- Customization Section -->
<div id="customization">
  <CustomStepsSection customizeTitle={t("armour.customize.title")} customizeDescription={t("armour.customize.description")} customizationSteps={customizationSteps} />
</div>

<!-- Contact Section -->
<ContactSection bgImg={CompanyBg01Img} contactTitle={t("armour.cta.title")} contactDescription={t("armour.cta.description")} lang={lang} />

<script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />
