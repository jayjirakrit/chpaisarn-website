---

<style>
  .hero-section {
    background-size: cover;
    background-position: center;
    display: flex;
    align-items: flex-end;
    justify-content: flex-start;
    position: relative;
    padding: 6rem 4rem;
    min-height: 466px;
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to right, rgba(20, 55, 95, 0.5) 0%, rgba(20, 55, 95, 0.5) 70%, transparent 100%);
  }

  .hero-content {
    position: relative;
    z-index: 10;
    max-width: 535px;
  }

  .options-nav {
    background-color: var(--primary-900);
    padding: 1.25rem 6.25rem;
    display: flex;
    gap: 2rem;
    align-items: center;
  }

  .option-card {
    width: 80%;
    background-color: #2465ae;
    border-radius: 5px;
    padding: 2rem;
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.15);
  }

  .option-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    margin-bottom: 1.5rem;
    padding-bottom: 1rem;
    /* border-bottom: 4px solid #9af9cf; */
  }

  .option-label {
    font-family: "Space Grotesk", sans-serif;
    font-weight: 700;
    font-size: 12px;
    color: white;
    padding-bottom: 0.5rem;
    border-bottom: 3px solid #9af9cf;

  }

  .option-title {
    font-family: "Hanken Grotesk", sans-serif;
    font-weight: 700;
    font-size: 28px;
    color: white;
  }

  .option-features {
    list-style-type: disc;
    padding-left: 1.5rem;
    color: white;
  }

  .option-features li {
    margin-bottom: 0.75rem;
    font-size: 16px;
    line-height: 1.4;
  }

  .customize-section {
    background-color: var(--primary-900);
    padding: 5rem 6.25rem;
  }

  .customize-header {
    margin-bottom: 4rem;
  }

  .customize-title {
    font-size: 58px;
    color: white;
    margin-bottom: 1.5rem;
  }

  .customize-description {
    font-size: 16px;
    color: white;
    line-height: 1.4;
    margin-bottom: 2rem;
  }

  .customize-cta {
    display: flex;
    gap: 0.5rem;
    align-items: center;
    color: white;
    font-family: "Space Grotesk", sans-serif;
    font-weight: 700;
    font-size: 18px;
  }

  .customize-step {
    display: flex;
    gap: 2.25rem;
    margin-bottom: 3rem;
  }

  .step-image {
    width: 100%;
    height: 196px;
    border-radius: 8px;
    object-fit: cover;
    flex-shrink: 0;
    margin-bottom: 2rem;
  }

  .step-content {
    flex: 1;
  }

  .step-header {
    border-right: 4px solid #9af9cf;
    padding-right: 1.5rem;
    margin-bottom: 1.5rem;
    padding-bottom: 1rem;
  }

  .step-label {
    font-family: "Hanken Grotesk", sans-serif;
    font-weight: 700;
    font-size: 16px;
    color: white;
    margin-bottom: 0.5rem;
  }

  .step-title {
    font-family: "Hanken Grotesk", sans-serif;
    font-weight: 700;
    font-size: 28px;
    color: white;
  }

  .step-items {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2rem;
  }

  .step-item-title {
    font-family: "Hanken Grotesk", sans-serif;
    font-weight: 700;
    font-size: 21px;
    color: white;
    margin-bottom: 0.5rem;
  }

  .step-item-desc {
    font-family: "Hanken Grotesk", sans-serif;
    font-size: 16px;
    color: white;
    line-height: 1.4;
  }

  .cta-section {
    background-size: cover;
    background-position: center;
    position: relative;
    padding: 6.25rem 9.375rem;
    display: flex;
    align-items: center;
    justify-content: flex-start;
  }

  .cta-box {
    background-color: var(--primary-900);
    border-radius: 5px;
    padding: 2.25rem;
    max-width: 446px;
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.15);
    position: relative;
    z-index: 10;
  }

  .cta-title {
    font-family: "Hanken Grotesk", sans-serif;
    font-weight: 700;
    font-size: 38px;
    color: white;
    margin-bottom: 1.25rem;
  }

  .cta-description {
    font-family: "Gotham", sans-serif;
    font-size: 16px;
    color: white;
    line-height: 1.4;
    margin-bottom: 2rem;
  }

  .cta-button {
    background-color: #58bb90;
    border: none;
    border-radius: 5px;
    padding: 0.75rem 1.5rem;
    width: 100%;
    cursor: pointer;
    transition: background-color 0.3s ease;
  }

  .cta-button:hover {
    background-color: #4fa07d;
  }

  .cta-button-text {
    font-family: "Space Grotesk", sans-serif;
    font-weight: 700;
    font-size: 24px;
    color: white;
  }

  @media (max-width: 768px) {
    .hero-section {
      padding: 3rem 2rem;
      min-height: auto;
    }

    .options-nav {
      padding: 1rem 2rem;
      flex-direction: column;
    }

    .customize-section {
      padding: 2rem;
    }

    .step-items {
      grid-template-columns: 1fr;
    }

    .customize-step {
      flex-direction: column;
    }

    .step-image {
      width: 100%;
    }

    .cta-section {
      padding: 2rem;
    }

    .cta-box {
      max-width: 100%;
    }
  }
</style>

<!-- Hero Section -->
<section class="hero-section" style={`background-image: url(${CompanyBgImg.src}); background-color: var(--primary-900);`}>
  <div class="hero-content">
    <h1 class="heading-h2 text-white hero-title mb-4">{pageTitle}</h1>
    <p class="body-text heading-h6 text-white" style="max-width: 535px;">{pageDescription}</p>
  </div>
</section>

<!-- Options Navigation -->
<div class="options-nav flex justify-center">
  <p style="color: white; margin: 0; font-family: 'Hanken Grotesk', sans-serif; font-weight: 700; font-size: 21px;">Your Options</p>
  <p style="color: white; margin: 0; font-family: 'Hanken Grotesk', sans-serif; font-weight: 400; font-size: 21px;">Customization</p>
</div>

<!-- Your Options Section -->
<section style="background-color: white; padding: 5rem 6.25rem;">
  <div style="margin-bottom: 3rem;">
    <h2 class="heading-h2" style="color: var(--primary-900); margin-bottom: 1.5rem;">{optionsTitle}</h2>
    <p class="body-text" style="margin-bottom: 1rem;">{optionsDescription}</p>
  </div>

  <div class="flex flex-col justify-center items-center gap-8">
    {
      protectionOptions.map((option) => (
        <div class="option-card">
          <div class="option-header">
            <span class="option-label">{option.label}</span>
            <h3 class="option-title">{option.title}</h3>
          </div>
          <ul class="option-features">
            {option.features.map((feature) => (
              <li>{feature}</li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
</section>

<!-- Customization Section -->
<section class="customize-section">
  <div class="customize-header">
    <h2 class="customize-title">{customizeTitle}</h2>
    <p class="customize-description">{customizeDescription}</p>
    <div class="customize-cta">
      <p style="margin: 0;">Contact Us for Customization</p>
      <span>→</span>
    </div>
  </div>

  <!-- Customization Steps -->
  <div>
    {
      customizationSteps.map((step) => (
        <img src={step.image} alt={step.title} class="step-image" />
        <div class="customize-step">
          <div class="step-header">
            <p class="step-label">{step.step}</p>
            <h3 class="step-title">{step.title}</h3>
          </div>
          <div class="step-content">
            {step.items ? (
              <div class="step-items">
                {step.items.map((item) => (
                  <div>
                    <p class="step-item-title">{item.name}</p>
                    <p class="step-item-desc">{item.desc}</p>
                  </div>
                ))}
              </div>
            ) : (
              <p class="step-item-desc">{step.content}</p>
            )}
          </div>
        </div>
      ))
    }
  </div>
</section>

<!-- Contact Section -->
<section class="cta-section" style={`background-image: url(${CompanyBg01Img.src});`}>
  <div class="cta-box">
    <h2 class="cta-title">{ctaTitle}</h2>
    <p class="cta-description">{ctaDescription}</p>
    <button class="cta-button">
      <span class="cta-button-text">Contact Us</span>
    </button>
  </div>
</section>
