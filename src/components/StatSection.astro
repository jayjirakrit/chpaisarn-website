---
import StatBgImg from "@/assets/company/protection_bg.png";
import type { Lang } from "@/i18n/types";
import { useTranslations } from "@/i18n/utils";

interface Props {
  lang?: Lang;
}

const { lang = "en" } = Astro.props;
const t = useTranslations(lang);

const title = t("stat.title");
const stats = t("stat.items");
---

<section
    id="stat"
    class="stat-section section-padding"
    style={`background-image: url(${StatBgImg.src});`}
>
    <h4 class="stat-title">{title}</h4>

    <div class="stat-content">
        {
            stats.map((stat) => (
                <div class={`stat-card${stat.wide ? " stat-card--wide" : ""}`}>
                    <h1 class="stat-number" data-target={stat.number.replace(/,/g, "")} data-suffix={stat.suffix}>
                        0{stat.suffix}
                    </h1>
                    <div class="stat-card-content">
                        <h5 class="stat-card-title">{stat.title}</h5>
                        <h6 class="stat-card-desc">{stat.desc}</h6>
                    </div>
                </div>
            ))
        }
    </div>
</section>

<script>
  const animateStats = () => {
    const els = document.querySelectorAll<HTMLElement>(".stat-number");

    const animate = (el: HTMLElement) => {
      const target = parseInt(el.dataset.target ?? "0", 10);
      const suffix = el.dataset.suffix ?? "";
      const duration = 2000;
      const start = performance.now();

      const tick = (now: number) => {
        const progress = Math.min((now - start) / duration, 1);
        el.textContent = Math.round(progress * target).toLocaleString() + suffix;
        if (progress < 1) requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);
    };

    const observer = new IntersectionObserver(
      (entries, obs) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          els.forEach(animate);
          obs.disconnect();
        });
      },
      { threshold: 0.3 },
    );

    const section = document.getElementById("stat");
    if (section) observer.observe(section);
  };
  
  animateStats();
  document.addEventListener("astro:after-swap", animateStats);
</script>

<style>
    .stat-section {
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
        display: flex;
        flex-direction: column;
        gap: 1.25rem;
    }

    .stat-title {
        color: var(--primary-900);
    }

    .stat-content {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 0.75rem;
        text-align: center;
    }

    .stat-card {
        background-color: var(--primary-500);
        border-radius: 0.5rem;
        padding: 0.75rem;
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
    }

    .stat-card--wide {
        grid-column: 1 / -1;
        align-items: center;
        text-align: center;
    }

    .stat-number {
        font-family: "Space Grotesk", sans-serif;
        line-height: 1;
        color: var(--accent);
    }

    .stat-card-title,
    .stat-card-desc {
        color: var(--white);
    }

    /* Tablet and above */
    @media only screen and (min-width: 768px) {
        .stat-section {
            padding: 6.25rem 4.5rem;
            flex-direction: row;
            gap: 2rem;
        }

        .stat-title {
            padding-right: 1.25rem;
            border-right: 3px solid var(--secondary-500);
        }

        .stat-content {
            display: grid;
            gap: 2rem;
        }
        .stat-card {
            flex-direction: row;
            justify-content: center;
            text-align: left;
            gap: 1rem;
        }
        .stat-card--wide {
            align-items: center;
            text-align: left;
        }

        .stat-number {
            /* flex: 1; */
            text-align: center;
        }

        .stat-card-content {
            flex: 1.5;
        }

        .stat-card--wide .stat-number {
            flex: 2.5;
        }
    }

    /* Desktop and above */
    @media only screen and (min-width: 1024px) {
        .stat-section {
            padding: 6.25rem 14rem;
            gap: 4rem;
        }
        .stat-content {
            gap: 2rem;
        }
        .stat-card {
            padding: 1.25rem;
        }

        .stat-card--wide {
            width: 80%;
            margin: 0 auto;

            .stat-number {
                flex: 2;
            }
            .stat-card-content {
                flex: 1;
            }
        }

    }
</style>
