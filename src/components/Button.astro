---
interface Props {
  variant?: 'primary' | 'secondary';
  href?: string;
}

const { variant = 'primary', href } = Astro.props;

const baseStyles = 'font-semibold py-4 px-6 rounded inline-flex items-center transition-all duration-200';
const primaryStyles = 'bg-[var(--cta-blue)] text-white hover:bg-white hover:text-[var(--cta-blue)] hover:outline-3 hover:outline-[var(--cta-blue)]';
const secondaryStyles = 'bg-white text-[var(--cta-blue)] border-2 border-[var(--cta-blue)] hover:bg-[var(--cta-blue)] hover:text-white';

const buttonClass = `${baseStyles} ${variant === 'primary' ? primaryStyles : secondaryStyles}`;

const Tag = href ? 'a' : 'button';
---

<Tag class={buttonClass} href={href}>
  <slot />
</Tag>
