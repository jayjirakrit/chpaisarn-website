---
import HeroBgImg from "@/assets/company/hero_bg.png";
import HeroBgMobileImg from "@/assets/company/hero_bg_mobile.png";
import ProductBgImg from "@/assets/company/factory_01_bg.svg";
import CompanyBgImg from "@/assets/company/company_bg.png";
import CompanyBg01MobileImg from "@/assets/company/company_bg_01_mobile.png";
import CompanyBg02MobileImg from "@/assets/company/company_bg_02_mobile.png";
import CompanyBg03Img from "@/assets/company/company_bg_03.png";
import CompanyBg03MobileImg from "@/assets/company/company_bg_03_mobile.png";
import CompanyBg04Img from "@/assets/company/company_bg_04.png";
import ContactBgImg from "@/assets/company/contact_bg.svg";
import Collapse from "@/components/collapse/Collapse.tsx";
import ContactSection from "@/components/ContactSection.astro";
import ArmorImg from "@/assets/products/body_armor_1.png";
import CvcHelmetImg from "@/assets/products/helmet/helmet_fast_green.png";
import PlateIIIImg from "@/assets/products/plate/plate_III.png";

// Hero section data
const heroTitle1 = "Part of Every Mission.";
const heroTitle2 = "Proud of Every Success.";

// Products section data
const productsTitle = "Our Products";
const productsDescription =
  "From personal protection to specialized security solutions, every CHP® product is designed, manufactured, and tested in-house purpose-built to meet the specific demands of military, law enforcement, and security operations.";
const cards = [
  {
    label: "Body Armors",
    description:
      "Our Body Armors provide cutting-edge protection across three main categories, ensuring comprehensive safety for law enforcement, military, and security personnel. Whether you're facing bullets, knives, spikes, or a combination of both, we offer the flexibility to tailor your protection.",
    buttonText: "Explore Body Armors",
    bgColor: "bg-[#14375f]",
    bgImage: CompanyBgImg.src,
    bgImageMobile: CompanyBg01MobileImg.src,
    productImage: ArmorImg.src,
    link: "/products"
  },
  {
    label: "Ballistic Helmets",
    description:
      "Engineered from advanced materials to provide high-impact defense against ballistic threats and blunt trauma without sacrificing mobility. These lightweight, durable helmets are fully customizable in shape and specification to meet unique operational or environmental demands.",
    buttonText: "Explore Ballistic Helmets",
    bgColor: "bg-[#2465ae]",
    bgImage: CompanyBg04Img.src,
    bgImageMobile: CompanyBg02MobileImg.src,
    productImage: CvcHelmetImg.src,
    link: "/products/ballistic-helmets"
  },
  {
    label: "Armor Plates",
    description:
      "Our armor Plates provide customizable solutions for personal protection. With options ranging from Level III to Level IV, each plate is tested for performance and durability to protect against high-velocity rounds.",
    buttonText: "Explore Armor Plates",
    bgColor: "bg-[#90b9e7]",
    bgImage: CompanyBg03Img.src,
    bgImageMobile: CompanyBg03MobileImg.src,
    productImage: PlateIIIImg.src,
    link: "/products/ballistic-plates"
  },

  {
    label: "Other Solutions",
    description:
      "We offer a wide range of ballistic protection products beyond traditional body armor and armored vehicles. From custom-sized solutions to specialized coatings, we provide innovative protection for various needs.<br/><br/> Our additional products include ballistic shields, bomb blankets, backpacks, briefcases, wall panels, and more each designed to offer reliable protection in diverse environments.",
    buttonText: "Explore Other Solution",
    bgColor: "bg-[#194577]",
    bgImage: CompanyBgImg.src,
    bgImageMobile: CompanyBg01MobileImg.src,
  },
];

// Team section data
const teamTitle = "Discover Ch.Paisarn";
const teamDescription1 =
  "Our absolute commitment to safety drives every design decision we make ensuring every piece of equipment delivers uncompromised reliability, durability, and protection when it matters most.";
const teamDescription2 =
  "As Thailand's largest manufacturer of ballistic protection equipment, we engineering high-performance gear built to withstand tropical environments and the toughest operational conditions in the field.";

// Trust partner section data
const partnersTitle = "Trusted by our partners";
const partnersDescription =
  "We are proud to partner with the organizations and personnel who protect our nation's frontline. Every piece of gear we manufacture has been rigorously tested and proven through real-world deployment in active operational fields and critical border zones. These strategic partnerships stand as a testament to our unyielding commitment to life-saving reliability under the toughest conditions.";
const partners = [
  {
    name: "Royal Thai Armed Forces",
    img: "/images/partners/royal-thai-armed-forces.png",
  },
  {
    name: "The Royal Thai Police (RTP)",
    img: "/images/partners/royal-thai-police.png",
  },
  {
    name: "Department of Provincial Administration",
    img: "/images/partners/provincial-administration.png",
  },
  { name: "United Nation (UN)", img: "/images/partners/united-nations.png" },
  {
    name: "Quartermaster Department",
    img: "/images/partners/rtaf-1.png",
  },
  {
    name: "Royal Thai Army Medical Department",
    img: "/images/partners/rta-medical-1.png",
  },
  {
    name: "The Royal Thai Air Force (RTAF)",
    img: "/images/partners/rtaf-2.png",
  },
  {
    name: "Territorial Defense Command (TDC)",
    img: "/images/partners/territorial-defense.png",
  },
  {
    name: "Royal Thai Army Medical Department",
    img: "/images/partners/rta-medical-2.png",
  },
];

// Contact section data
const contactTitle = "Get in Touch";
const contactDescription =
  "Contact us to learn more about our defense solutions or to discuss your specific operational requirements. Our team is ready to provide the expertise and custom-engineered armor solutions needed to meet your mission objectives.";

---

<!-- Hero Section -->
<section class="hero-section" style={`--hero-bg: url(${HeroBgImg.src}); --hero-bg-mobile: url(${HeroBgImg.src}); background-color: var(--primary-900);`}>
  <div class="hero-content">
    <h1 class="hero-title">{heroTitle1}</h1>
    <h1 class="hero-title">{heroTitle2}</h1>
    <div class="cta-group">
      <div class="btn-primary">Explore our products</div>
      <div class="btn-secondary">Learn more</div>
    </div>
  </div>
</section>

<!-- Our Products Section -->
<section class="product-section bg-gray-50" style={`background-image: url(${ProductBgImg.src});`}>
  <div class="product-container">
    <div class="mb-12 flex flex-col md:flex-row md:items-end md:justify-between">
      <div>
        <h2 class="text-(--primary-900) mb-4">{productsTitle}</h2>
        <p class="body-text mb-4">{productsDescription}</p>
        <div class="flex flex-col lg:flex-row gap-2 items-end justify-end">
          <button class="btn-primary" style="font-size: 1.125rem;">
            View Products
          </button>
          <button class="customize-btn">
            Customize your product
            <span>→</span>
          </button>
        </div>
      </div>
    </div>

    <!-- Product Grid -->
    <Collapse client:visible cards={cards} />
  </div>
</section>

<!-- Team Section -->
<section class="team-section">
  <div class="team-container">
    <div class="grid md:grid-cols-2 gap-12 items-center">
      <div class="space-y-4">
        <div class="team-video team-video-placeholder" id="team-video-placeholder">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 68 48" width="68" height="48" aria-hidden="true">
            <rect width="68" height="48" rx="10" fill="#ff0000"/>
            <polygon points="27,14 27,34 47,24" fill="white"/>
          </svg>
        </div>
      </div>

      <!-- Content -->
      <div class="team-content text-white">
        <h2 class="mb-6 whitespace-nowrap">{teamTitle}</h2>
        <p class="body-text-sm mb-4">{teamDescription1}</p>
        <p class="body-text-sm mb-4 lg:mb-8">{teamDescription2}</p>
        <button class="btn-primary">
          Learn Our Story
        </button>
      </div>
    </div>
  </div>
</section>

<!-- Trust Partner Section -->
<section class="partners-section">
  <div class="partners-head">
    <h2 class="partners-title reveal">{partnersTitle}</h2>
    <p class="partners-description reveal" style="transition-delay: 0.1s">{partnersDescription}</p>
  </div>

  <div class="partners-grid">
    {
      partners.map((partner, index) => (
        <div class="partner-card reveal" style={`transition-delay: ${index * 80}ms`}>
          <div class="partner-logo">
            <img src={partner.img} alt={partner.name} loading="lazy" decoding="async" />
          </div>
          <span class="partner-name body-text-sm">{partner.name}</span>
        </div>
      ))
    }
  </div>
</section>

<!-- Contact Section -->
<ContactSection
  bgImg={ContactBgImg}
  contactTitle={contactTitle}
  contactDescription={contactDescription}
  bgColor="primary-50"
  titleColor="primary-700"
  desColor="black"
/>

<style>
  @keyframes fadeUp {
    from {
      opacity: 0;
      transform: translateY(1.5rem);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .hero-section {
    background-image: var(--hero-bg-mobile);
    background-size: cover;
    background-position: center;
    display: flex;
    align-items: center;
    justify-content: flex-start;
    position: relative;
    padding: 3rem 1.3125rem;
    min-height: 100vh;
  }

  .hero-content {
    position: relative;
    z-index: 10;
    max-width: 1000px;
    font-family: var(--font-space);
    font-weight: 700;
  }

  .hero-title {
    color: white;
    margin-bottom: 2.5rem;
  }

  .hero-title:nth-child(1) {
    animation: fadeUp 0.7s ease 0.1s both;
  }

  .hero-title:nth-child(2) {
    animation: fadeUp 0.7s ease 0.3s both;
  }

  .cta-group {
    display: flex;
    gap: 2rem;
    flex-wrap: wrap;
    animation: fadeUp 0.7s ease 0.5s both;
  }

  .customize-btn {
    font-family: var(--font-space);
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--primary-900);
    background: none;
    border: none;
    padding: 0.5rem;
    display: flex;
    gap: 0.5rem;
    align-items: center;
    cursor: pointer;
    transition: color 0.2s ease;
  }

  .customize-btn:hover {
    color: var(--primary-500);
  }

  .team-section {
    background-color: var(--primary-900);
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 4rem 1.25rem;
  }

  .team-container {
    display: flex;
  }

  .team-image {
    display: block;
    width: 100%;
    height: 20rem;
    border-radius: 1rem;
    object-fit: cover;
    flex-shrink: 0;
  }

  .team-video {
    height: 16.5rem;
    width: 100%;
    overflow: hidden;
  }

  .team-video-placeholder {
    background-color: white;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    border-radius: 1rem;
  }

  .product-section {
    padding: 2rem;
    padding: 4rem 1.25rem;
    isolation: isolate;
  }

  .product-container {
    flex-direction: column;
    gap: 48px;
    isolation: isolate;
  }

  .partners-section {
    background-color: var(--white);
    padding: 4rem 1.25rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 3rem;
  }

  .partners-head {
    width: 100%;
    max-width: 68.125rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .partners-title {
    font-family: var(--font-hanken);
    font-weight: 700;
    font-size: 2.25rem;
    text-transform: capitalize;
    color: var(--primary-900);
  }

  .partners-description {
    font-family: var(--font-hanken);
    font-weight: 400;
    font-size: 1rem;
    line-height: 1.4;
    color: var(--black);
  }

  .partners-grid {
    width: 100%;
    max-width: 68.125rem;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 2rem 1rem;
  }

  .partner-card {
    width: calc((100% - 2rem) / 3);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.125rem;
  }

  .partner-logo {
    width: 100%;
    height: 10rem;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .partner-logo img {
    width: 8rem;
    height: 8rem;
    object-fit: contain;
    transition: transform 0.25s ease, filter 0.25s ease;
    filter: grayscale(30%);
  }

  .partner-card:hover .partner-logo img {
    transform: scale(1.08);
    filter: grayscale(0%);
  }

  .partner-name {
    font-family: var(--font-hanken);
    font-weight: 400;
    line-height: 1.4;
    color: var(--black);
    text-align: center;
  }

  /* Tablet and above (min-width) */
  @media only screen and (min-width: 768px) {
    .hero-section {
      background-image: var(--hero-bg);
    }
    .team-section {
      padding: 6.25rem;
      flex-direction: row;
    }
    .partners-section {
      padding: 6.25rem;
      gap: 3rem;
    }
    .product-section {
      padding: 4.6875rem;
    }
    .partners-title {
      font-size: 3.625rem;
    }
  }

  /* Desktop and above */
  @media only screen and (min-width: 1024px) {
    .hero-section {
      padding: 6rem 4rem;
    }
    .product-section {
      padding: 6.25rem;
    }
    .product-container {
      padding: 0 6.25rem;
    }
    .team-section {
      justify-content: center;
    }
    .team-video {
      width: 28.125rem;
      height: 21.25rem;
      border-radius: 1rem;
      overflow: hidden;
    }
    .team-content {
      width: 31.25rem;
    }
    .partners-section {
      padding: 3rem 2rem;
      gap: 3rem;
    }
    .partner-card {
      width: calc(20% - 0.8rem);
    }
  }
</style>

<script>
  import $ from "jquery";

  $("#team-video-placeholder").on("click", function () {
    const $placeholder = $(this);
    const width = $placeholder.outerWidth();
    const height = $placeholder.outerHeight();
    const borderRadius = $placeholder.css("border-radius");
    $("<iframe>")
      .attr({
        src: "https://www.youtube.com/embed/hOm-Hv6FT1I?si=fAvULb6s6OsnHqA2&autoplay=1",
        title: "YouTube video player",
        allow: "accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share",
        referrerpolicy: "strict-origin-when-cross-origin",
        allowfullscreen: "",
      })
      .css({
        width: width + "px",
        height: height + "px",
        borderRadius: borderRadius,
        display: "block",
        flexShrink: "0",
      })
      .replaceAll($placeholder);
  });
</script>
