---
import HeroBgImg from "@/images/company/hero_bg.svg";
import ProductBgImg from "@/images/company/factory_01_bg.svg";
import CompanyBgImg from "@/images/company/company_bg.png";

// Hero section data
const heroTitle = '"Your Trusted Partner in Ballistic Protection"';

// Products section data
const productsTitle = "Our Products";
const productsDescription =
  "We offer a wide range of ballistic protection products designed to meet the demands of military, law enforcement, security, and civilian applications. Whether you're seeking personal protection or armored vehicle solutions, our products provide the ultimate defense against ballistic threats.";

// Team section data
const teamTitle = "Meet The Team";
const teamDescription =
  "We specialize in crafting high-performance ballistic protection tailored to meet the unique needs of our clients. With years of expertise, our products are trusted globally by military and law enforcement agencies to defend against the most formidable threats. Committed to excellence, we provide top-tier defense against firearms, explosive fragments, and edged weapons, all while respecting our clients' budgets. Our solutions deliver unmatched safety, reliability, and performance, even in the most demanding conditions.";

// Contact section data
const contactTitle = "Get in Touch";
const contactDescription =
  "Contact us to learn more about our defense solutions or to discuss your specific operational requirements. Our team is ready to provide the expertise and custom-engineered armor solutions needed to meet your mission objectives.";
---

<style>
  .hero-section {
    background-size: cover;
    background-position: center;
    display: flex;
    align-items: center;
    justify-content: flex-start;
    position: relative;
    padding: 6rem 4rem;
    min-height: 100vh;
  }

  .hero-content {
    position: relative;
    z-index: 10;
    max-width: 900px;
  }

  .hero-title {
    color: white;
    margin-bottom: 3rem;
  }

  .cta-group {
    display: flex;
    gap: 2rem;
    flex-wrap: wrap;
  }

  .product-card {
    display: flex;
    align-items: start;
    justify-content: center;
    min-height: 400px;
    padding: 2rem;
  }

  .product-main {
    background: linear-gradient(135deg, rgba(20, 55, 95, 0.3), rgba(20, 55, 95, 0.3));
    position: relative;
    border-bottom: 10px solid #58bb90;
  }

  .product-card-container {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    width: 100%;
  }

  .product-label-vertical {
    color: white;
    white-space: nowrap;
  }

  .product-content {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    width: 100%;
    height: auto;
    align-items: center;
  }

  .product-description {
    width: 80%;
  }

  @media (max-width: 1024px) {
    .hero-section {
      padding: 4rem 2rem;
    }

    .cta-group {
      flex-direction: column;
    }
  }

  /* Tablet and above (min-width) */
  @media only screen and (min-width: 768px) {
    .product-card-container {
      flex-direction: row;
      gap: 0;
    }
    .products-grid {
      grid-template-columns: 1fr;
    }

    .product-content {
      flex-direction: row;
      gap: 0.5rem;
      justify-content: space-evenly;
    }

    .product-label-vertical {
      writing-mode: vertical-rl;
      text-orientation: mixed;
      transform: rotate(180deg);
    }
  }

  /* Desktop and above */
  @media only screen and (min-width: 1024px) {
  }
</style>

<!-- Hero Section -->
<section class="hero-section" style={`background-image: url(${HeroBgImg.src}); background-color: var(--primary-900);`}>
  <div class="heading-h1 hero-content">
    <h1 class="hero-title">{heroTitle}</h1>
    <div class="cta-group">
      <div class="btn-primary">Explore our products</div>
      <div class="btn-secondary">Learn more</div>
    </div>
  </div>
</section>

<!-- Our Products Section -->
<section class="section-padding bg-gray-50" style={`background-image: url(${ProductBgImg.src});`}>
  <div class="mx-auto">
    <div class="mb-12 flex flex-col md:flex-row md:items-end md:justify-between">
      <div>
        <h2 class="heading-h2 text-(--primary-900) mb-4">{productsTitle}</h2>
        <p class="body-text mb-4">{productsDescription}</p>
        <div class="flex gap-4 justify-end">
          <button
            class="bg-[#58bb90] text-white font-bold py-2 px-5 rounded-sm hover:opacity-90 transition-all"
            style="font-family: 'Space Grotesk'; font-size: 18px;"
          >
            View Products
          </button>
          <button
            class="text-[#14375f] font-bold hover:text-[#2465ae] transition-colors flex gap-2 items-center"
            style="font-family: 'Space Grotesk'; font-size: 18px;"
          >
            Customize your product
            <span>→</span>
          </button>
        </div>
      </div>
    </div>

    <!-- Product Grid -->
    <div class="product-card-container flex w-full rounded-lg overflow-hidden">
      <!-- Main Product Card -->
      <div class="product-card product-main flex-9" style={`background-image: url(${CompanyBgImg.src});`}>
        <div class="product-content flex gap-4 w-full h-full justify-between">
          <div class="heading-h3 flex justify-end product-label-vertical">Body Armors</div>
          <div class="product-description">
            <p class="text-white text-lg leading-relaxed mb-4">
              Our Body Armors provide cutting-edge protection across three main categories, ensuring comprehensive safety for law enforcement,
              military, and security personnel. Whether you're facing bullets, knives, spikes, or a combination of both, we offer the flexibility to
              tailor your protection.
            </p>
            <button class="text-white font-bold flex gap-2 items-center hover:underline">
              Explore Body Armors
              <span>→</span>
            </button>
          </div>
        </div>
      </div>

      <!-- Helmet Card -->
      <div class="product-card bg-[#2465ae] lg:flex-1">
        <div class="heading-h3 product-label-vertical">Ballistic Helmets</div>
      </div>

      <!-- Plates Card -->
      <div class="product-card bg-[#90b9e7] lg:flex-1">
        <div class="heading-h3 product-label-vertical">Ballistic Plates</div>
      </div>

      <!-- Solutions Card -->
      <div class="product-card bg-[#194577] lg:flex-1">
        <div class="heading-h3 product-label-vertical">Other Ballistic Solutions</div>
      </div>
    </div>
  </div>
</section>

<!-- Team Section -->
<section class="section-padding bg-[#194577]">
  <div class="amx-auto">
    <div class="grid md:grid-cols-2 gap-12 items-center">
      <!-- Images -->
      <div class="space-y-4">
        <div class="bg-gray-400 rounded-lg h-96 w-full flex items-center justify-center">
          <span class="text-white text-lg">Image</span>
        </div>
      </div>

      <!-- Content -->
      <div class="text-white">
        <h2 class="heading-h2 mb-6">{teamTitle}</h2>
        <p class="body-text mb-8">{teamDescription}</p>
        <button
          class="bg-[#58bb90] text-white font-bold py-3 px-6 rounded-sm hover:opacity-90 transition-all"
          style="font-family: 'Space Grotesk'; font-size: 24px;"
        >
          Check Our Story
        </button>
      </div>
    </div>
  </div>
</section>

<!-- Past Projects Section -->
<section class="section-padding bg-[#5e99dc]">
  <div class="max-w-7xl mx-auto">
    <h2 class="heading-h4 mb-8 text-center text-white">Past projects / success story placeholder</h2>
  </div>
</section>

<!-- Contact Section -->
<section class="section-padding bg-cover bg-center bg-white" style={`background-image: url(${ProductBgImg.src});`}>
  <div class="max-w-7xl mx-auto relative z-10 flex justify-end">
    <div class="bg-[#14375f] rounded-sm p-9 max-w-md shadow-lg">
      <h3 class="heading-h3 text-white mb-4">{contactTitle}</h3>
      <p class="text-white text-base leading-relaxed mb-8">{contactDescription}</p>
      <button
        class="bg-[#58bb90] text-white font-bold py-3 px-6 rounded-sm hover:opacity-90 transition-all w-full"
        style="font-family: 'Space Grotesk'; font-size: 24px;"
      >
        Contact Us
      </button>
    </div>
  </div>
</section>
