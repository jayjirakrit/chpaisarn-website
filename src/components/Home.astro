---
import HeroBgImg from "@/images/company/hero_bg.svg";
import ProductBgImg from "@/images/company/factory_01_bg.svg";
import CompanyBgImg from "@/images/company/company_bg.png";
import CompanyBg03Img from "@/images/company/company_bg_03.png";
import CompanyBg04Img from "@/images/company/company_bg_04.png";
import ContactBgImg from "@/images/company/contact_bg.svg";
import Collapse from "@/components/collapse/Collapse.tsx";
import ContactSection from "@/components/ContactSection.astro";
import ArmorImg from "@/images/products/body_armor_1.png";
import CvcHelmetImg from "@/images/products/cvc_helmet.svg";

// Hero section data
const heroTitle = '"Your Trusted Partner in Ballistic Protection"';

// Products section data
const productsTitle = "Our Products";
const productsDescription =
  "We offer a wide range of ballistic protection products designed to meet the demands of military, law enforcement, security, and civilian applications. Whether you're seeking personal protection or armored vehicle solutions, our products provide the ultimate defense against ballistic threats.";
const cards = [
  {
    label: "Body Armors",
    description:
      "Our Body Armors provide cutting-edge protection across three main categories, ensuring comprehensive safety for law enforcement, military, and security personnel. Whether you're facing bullets, knives, spikes, or a combination of both, we offer the flexibility to tailor your protection.",
    buttonText: "Explore Body Armors",
    bgColor: "bg-[#14375f]",
    bgImage: CompanyBgImg.src,
    productImage: ArmorImg.src,
  },
  {
    label: "Ballistic Helmets",
    description:
      "Engineered from advanced materials to provide high-impact defense against ballistic threats and blunt trauma without sacrificing mobility. These lightweight, durable helmets are fully customizable in shape and specification to meet unique operational or environmental demands.",
    buttonText: "Explore Ballistic Helmets",
    bgColor: "bg-[#2465ae]",
    bgImage: CompanyBg04Img.src,
    productImage: CvcHelmetImg.src,
  },
  {
    label: "Armor Plates",
    description:"Our armor Plates provide customizable solutions for personal protection. With options ranging from Level III to Level IV, each plate is tested for performance and durability to protect against high-velocity rounds.",
    buttonText: "Explore Armor Plates",
    bgColor: "bg-[#90b9e7]",
    bgImage: CompanyBg03Img.src,
    productImage: ArmorImg.src,
  },

  {
    label: "Other Solutions",
    description: "We offer a wide range of ballistic protection products beyond traditional body armor and armored vehicles. From custom-sized solutions to specialized coatings, we provide innovative protection for various needs.",
    buttonText: "Explore Other Solution",
    bgColor: "bg-[#194577]",
    bgImage: CompanyBgImg.src,
    productImage: ArmorImg.src,
  },
];

// Team section data
const teamTitle = "Meet The Team";
const teamDescription =
  "As Thailand's largest manufacturer of ballistic protection equipment, we engineering high-performance gear built to withstand tropical environments and the toughest operational conditions in the field. Our absolute commitment to safety drives every design decision we make—ensuring every piece of equipment delivers uncompromised reliability, durability, and protection when it matters most.";
// Contact section data
const contactTitle = "Get in Touch";
const contactDescription =
  "Contact us to learn more about our defense solutions or to discuss your specific operational requirements. Our team is ready to provide the expertise and custom-engineered armor solutions needed to meet your mission objectives.";

// Trust partner section data
const partnersTitle = "Trusted by our partners";
const partnersDescription =
  "We are proud to partner with the organizations and personnel who protect our nation's frontline. Every piece of gear we manufacture has been rigorously tested and proven through real-world deployment in active operational fields and critical border zones. These strategic partnerships stand as a testament to our unyielding commitment to life-saving reliability under the toughest conditions.";
const partners = [
  {
    name: "Royal Thai Armed Forces",
    img: "/images/partners/royal-thai-armed-forces.png",
  },
  {
    name: "The Royal Thai Police (RTP)",
    img: "/images/partners/royal-thai-police.png",
  },
  {
    name: "Department of Provincial Administration",
    img: "/images/partners/provincial-administration.png",
  },
  { name: "United Nation (UN)", img: "/images/partners/united-nations.png" },
  {
    name: "The Royal Thai Air Force (RTAF)",
    img: "/images/partners/rtaf-1.png",
  },
  {
    name: "Royal Thai Army Medical Department",
    img: "/images/partners/rta-medical-1.png",
  },
  {
    name: "The Royal Thai Air Force (RTAF)",
    img: "/images/partners/rtaf-2.png",
  },
  {
    name: "Territorial Defense Command (TDC)",
    img: "/images/partners/territorial-defense.png",
  },
  {
    name: "Royal Thai Army Medical Department",
    img: "/images/partners/rta-medical-2.png",
  },
];
---

<!-- Hero Section -->
<section
  class="hero-section"
  style={`background-image: url(${HeroBgImg.src}); background-color: var(--primary-900);`}
>
  <div class="heading-h1 hero-content">
    <h1 class="hero-title">{heroTitle}</h1>
    <div class="cta-group">
      <div class="btn-primary">Explore our products</div>
      <div class="btn-secondary">Learn more</div>
    </div>
  </div>
</section>

<!-- Our Products Section -->
<section
  class="product-section bg-gray-50"
  style={`background-image: url(${ProductBgImg.src});`}
>
  <div class="product-container mx-auto">
    <div
      class="mb-12 flex flex-col md:flex-row md:items-end md:justify-between"
    >
      <div>
        <h2 class="heading-h2 text-(--primary-900) mb-4">{productsTitle}</h2>
        <p class="body-text mb-4">{productsDescription}</p>
        <div class="flex gap-4 justify-end">
          <button
            class="bg-[#58bb90] text-white font-bold py-2 px-5 rounded-sm hover:opacity-90 transition-all"
            style="font-family: 'Space Grotesk'; font-size: 18px;"
          >
            View Products
          </button>
          <button
            class="text-[#14375f] font-bold hover:text-[#2465ae] transition-colors flex gap-2 items-center"
            style="font-family: 'Space Grotesk'; font-size: 18px;"
          >
            Customize your product
            <span>→</span>
          </button>
        </div>
      </div>
    </div>

    <!-- Product Grid -->
    <Collapse client:visible cards={cards} />
  </div>
</section>

<!-- Team Section -->
<section class="team-section section-padding">
  <div class="amx-auto">
    <div class="grid md:grid-cols-2 gap-12 items-center">
      <div class="space-y-4">
        <!-- <Image
          src={CompanyBg03Img}
          alt="Company Background"
          class="team-image"
        /> -->
      </div>

      <!-- Content -->
      <div class="text-white">
        <h2 class="heading-h2 mb-6">{teamTitle}</h2>
        <p class="body-text mb-8">{teamDescription}</p>
        <button
          class="bg-[#58bb90] text-white font-bold py-3 px-6 rounded-sm hover:opacity-90 transition-all"
          style="font-family: 'Space Grotesk'; font-size: 24px;"
        >
          Learn Our Story
        </button>
      </div>
    </div>
  </div>
</section>

<!-- Trust Partner Section -->
<section class="partners-section">
  <div class="partners-head">
    <h2 class="partners-title">{partnersTitle}</h2>
    <p class="partners-description">{partnersDescription}</p>
  </div>

  <div class="partners-grid">
    {
      partners.map((partner) => (
        <div class="partner-card">
          <div class="partner-logo">
            <img src={partner.img} alt={partner.name} />
          </div>
          <span class="partner-name">{partner.name}</span>
        </div>
      ))
    }
  </div>
</section>

<!-- Contact Section -->
<ContactSection
  bgImg={ContactBgImg}
  contactTitle={contactTitle}
  contactDescription={contactDescription}
  bgColor="primary-50"
  titleColor="primary-700"
  desColor="black"
/>

<style>
  .hero-section {
    background-size: cover;
    background-position: center;
    display: flex;
    align-items: center;
    justify-content: flex-start;
    position: relative;
    padding: 6rem 4rem;
    min-height: 100vh;
  }

  .hero-content {
    position: relative;
    z-index: 10;
    max-width: 900px;
  }

  .hero-title {
    color: white;
    margin-bottom: 3rem;
  }

  .cta-group {
    display: flex;
    gap: 2rem;
    flex-wrap: wrap;
  }

  .team-section {
    background-color: var(--primary-900);
  }

  .team-image {
    display: block;
    width: 100%;
    height: 20rem;
    border-radius: 1rem;
    object-fit: cover;
    flex-shrink: 0;
  }

  .product-section {
    padding: 6.25rem;
    isolation: isolate;
  }

  .product-container {
    flex-direction: column;
    justify-content: center;
    align-items: center;
    padding: 0 6.25rem;
    gap: 48px;
    isolation: isolate;
  }

  .partners-section {
    background-color: var(--white);
    padding: 3rem 2rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 3rem;
  }

  .partners-head {
    width: 100%;
    max-width: 68.125rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .partners-title {
    font-family: var(--font-hanken);
    font-weight: 700;
    font-size: 2.25rem;
    text-transform: capitalize;
    color: var(--primary-900);
  }

  .partners-description {
    font-family: var(--font-hanken);
    font-weight: 400;
    font-size: 1rem;
    line-height: 1.4;
    color: var(--black);
  }

  .partners-grid {
    width: 100%;
    max-width: 68.125rem;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 2rem 1rem;
  }

  .partner-card {
    width: calc(50% - 0.5rem);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.125rem;
  }

  .partner-logo {
    width: 100%;
    height: 10rem;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .partner-logo img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
  }

  .partner-name {
    font-family: var(--font-hanken);
    font-weight: 400;
    font-size: 1rem;
    line-height: 1.4;
    color: var(--black);
    text-align: center;
  }

  @media (max-width: 1024px) {
    .hero-section {
      padding: 4rem 2rem;
    }

    .cta-group {
      flex-direction: column;
    }
  }

  /* Tablet and above (min-width) */
  @media only screen and (min-width: 768px) {
    .partners-section {
      padding: 6.25rem;
      gap: 3rem;
    }

    .partners-title {
      font-size: 3.625rem;
    }

    .partner-card {
      width: calc(20% - 0.8rem);
    }
  }

  /* Desktop and above */
  @media only screen and (min-width: 1024px) {
  }
</style>
