---
import HeroBgImg from "@/assets/company/hero_bg.png";
import ProductBgImg from "@/assets/company/factory_01_bg.svg";
import CompanyBgImg from "@/assets/company/company_bg.png";
import CompanyBg01MobileImg from "@/assets/company/company_bg_01_mobile.png";
import CompanyBg02MobileImg from "@/assets/company/company_bg_02_mobile.png";
import CompanyBg03Img from "@/assets/company/company_bg_03.png";
import CompanyBg03MobileImg from "@/assets/company/company_bg_03_mobile.png";
import CompanyBg04Img from "@/assets/company/company_bg_04.png";
import ContactBgImg from "@/assets/company/contact_bg.svg";
import VideoImg from "@/assets/company/video_bg.png";
import CarouselImg01 from "@/assets/products/armor/armor_01.png";
import Collapse from "@/components/collapse/Collapse.tsx";
import ContactSection from "@/components/ContactSection.astro";
import Carousel from "@/components/carousel/Carousel.astro";
import type { Lang } from "@/i18n/types";
import { useTranslations } from "@/i18n/utils";

interface Props {
  lang?: Lang;
}

const { lang = "en" } = Astro.props;
const t = useTranslations(lang);

// Image arrays matched to translation card order
const bgImages = [CompanyBgImg.src, CompanyBg04Img.src, CompanyBg03Img.src, CompanyBgImg.src];
const bgImagesMobile = [CompanyBg01MobileImg.src, CompanyBg02MobileImg.src, CompanyBg03MobileImg.src, CompanyBg01MobileImg.src];

const cards = t("home.cards").map((card, i) => ({
  ...card,
  bgImage: bgImages[i],
  bgImageMobile: bgImagesMobile[i],
}));

const partners = [
  { name: "Royal Thai Armed Forces", img: "/images/partners/royal-thai-armed-forces.png" },
  { name: "The Royal Thai Police (RTP)", img: "/images/partners/royal-thai-police.png" },
  { name: "Department of Provincial Administration", img: "/images/partners/provincial-administration.png" },
  { name: "United Nations (UN)", img: "/images/partners/united-nations.png" },
  { name: "Royal Thai Army Quartermaster Department", img: "/images/partners/rtaf-1.png" },
  { name: "Internal Security Operations Command (ISOC)", img: "/images/partners/rta-medical-1.png" },
  { name: "The Royal Thai Air Force (RTAF)", img: "/images/partners/rtaf-2.png" },
  { name: "Territorial Defense Command (TDC)", img: "/images/partners/territorial-defense.png" },
  { name: "Royal Thai Army Medical Department", img: "/images/partners/rta-medical-2.png" },
];

---

<!-- Hero Section -->
<section
  class="hero-section"
  style={`--hero-bg: url(${HeroBgImg.src}); --hero-bg-mobile: url(${HeroBgImg.src}); background-color: var(--primary-900);`}
>
  <div class="hero-content">
    <h5 class="hero-title hero-quote">{t("home.hero.quote")}</h5>
    <h1 class="hero-title">{t("home.hero.title1")}</h1>
    <h1 class="hero-title">{t("home.hero.title2")}</h1>
    <div class="cta-group">
      <a class="btn-primary" href="#product">{t("home.hero.ctaExplore")}</a>
      <a class="btn-secondary" href="#team">{t("home.hero.ctaLearn")}</a>
    </div>
  </div>
</section>

<!-- Our Products Section -->
<section id="product" class="product-section bg-gray-50" style={`background-image: url(${ProductBgImg.src});`}>
  <div class="product-container">
    <div class="mb-12 flex flex-col md:flex-row md:items-end md:justify-between">
      <div>
        <h2 class="text-(--primary-900) mb-4">{t("home.products.title")}</h2>
        <p class="body-text mb-4">{t("home.products.description")}</p>
        <!-- Comment Out Btn since no navigation defined -->
        <!-- <div class="flex flex-col lg:flex-row gap-2 items-end justify-end">
          <button class="btn-primary" style="font-size: 1.125rem;">
            {t("home.products.viewBtn")}
          </button>
          <button class="customize-btn">
            {t("home.products.customizeBtn")}
            <span>→</span>
          </button>
        </div> -->
      </div>
    </div>

    <!-- Product Grid -->
    <Collapse client:visible cards={cards} />
  </div>
</section>

<!-- Carousel Section -->
<section class="carousel-section">
  <h2 class="carousel-title reveal">{t("home.carousel.title")}</h2>
  <Carousel />
</section>

<!-- Trust Partner Section -->
<section class="partners-section">
  <div class="partners-head">
    <h2 class="partners-title reveal">{t("home.partners.title")}</h2>
    <p class="partners-description reveal" style="transition-delay: 0.1s">
      {t("home.partners.description")}
    </p>
  </div>

  <div class="partners-grid">
    {
      partners.map((partner, index) => (
        <div class="partner-card reveal" style={`transition-delay: ${index * 80}ms`}>
          <div class="partner-logo">
            <img src={partner.img} alt={partner.name} loading="lazy" decoding="async" />
          </div>
          <span class="partner-name body-text-sm">{partner.name}</span>
        </div>
      ))
    }
  </div>
</section>

<!-- Team Section -->
<section id="team" class="team-section">
  <div class="team-container">
    <div class="grid md:grid-cols-2 gap-12 items-center">
      <div class="space-y-4">
        <div class="team-video team-video-placeholder" id="team-video-placeholder">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 68 48" width="68" height="48" aria-hidden="true">
            <rect width="68" height="48" rx="10" fill="#ff0000"></rect>
            <polygon points="27,14 27,34 47,24" fill="white"></polygon>
          </svg>
        </div>
      </div>

      <!-- Content -->
      <div class="team-content text-white">
        <h2 class="mb-6 whitespace-nowrap">{t("home.team.title")}</h2>
        <p class="body-text-sm mb-4">{t("home.team.description1")}</p>
        <p class="body-text-sm mb-4 lg:mb-8">{t("home.team.description2")}</p>
        <button class="btn-primary">
          <a href={lang === "th" ? "/th/company" : "/company"}>{t("home.team.ctaLearn")}</a>
        </button>
      </div>
    </div>
  </div>
</section>

<!-- Contact Section -->
<ContactSection
  bgImg={ContactBgImg}
  contactTitle={t("home.contact.title")}
  contactDescription={t("home.contact.description")}
  bgColor="primary-50"
  titleColor="primary-700"
  desColor="black"
  lang={lang}
/>

<script>
  import $ from "jquery";

  $("#team-video-placeholder").on("click", function () {
    const $placeholder = $(this);
    const width = $placeholder.outerWidth();
    const height = $placeholder.outerHeight();
    const borderRadius = $placeholder.css("border-radius");
    $("<iframe>")
      .attr({
        src: "https://www.youtube.com/embed/hOm-Hv6FT1I?si=fAvULb6s6OsnHqA2&autoplay=1",
        title: "YouTube video player",
        allow: "accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share",
        referrerpolicy: "strict-origin-when-cross-origin",
        allowfullscreen: "",
      })
      .css({
        width: width + "px",
        height: height + "px",
        borderRadius: borderRadius,
        display: "block",
        flexShrink: "0",
      })
      .replaceAll($placeholder);
  });
</script>

<style define:vars={{ videoUrl: `url(${VideoImg.src})` }}>
  @keyframes fadeUp {
    from {
      opacity: 0;
      transform: translateY(1.5rem);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .hero-section {
    background-image: var(--hero-bg-mobile);
    background-size: cover;
    background-position: center;
    display: flex;
    align-items: center;
    justify-content: flex-start;
    position: relative;
    padding: 3rem 1.3125rem;
    min-height: 100vh;
  }

  .hero-content {
    position: relative;
    z-index: 10;
    max-width: 1000px;
    font-family: var(--font-space);
  }

  .hero-title {
    color: white;
    margin-bottom: 2.5rem;
  }

  .hero-quote {
    display: inline-block;
    padding-bottom: 0.75rem;
    border-bottom: 3px solid var(--accent);
  }

  .hero-title:nth-child(1) {
    animation: fadeUp 0.7s ease 0.1s both;
  }

  .hero-title:nth-child(2) {
    animation: fadeUp 0.7s ease 0.2s both;
  }

  .hero-title:nth-child(3) {
    animation: fadeUp 0.7s ease 0.3s both;
  }

  .cta-group {
    display: flex;
    gap: 2rem;
    flex-wrap: wrap;
    animation: fadeUp 0.7s ease 0.5s both;
  }

  .customize-btn {
    font-family: var(--font-space);
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--primary-900);
    background: none;
    border: none;
    padding: 0.5rem;
    display: flex;
    gap: 0.5rem;
    align-items: center;
    cursor: pointer;
    transition: color 0.2s ease;
  }

  .customize-btn:hover {
    color: var(--primary-500);
  }
  /* --------------------- Team Section ---------------------*/
  .team-section {
    background-color: var(--primary-900);
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 4rem 1.25rem;
  }

  .team-container {
    display: flex;
  }

  .team-image {
    display: block;
    width: 100%;
    height: 20rem;
    border-radius: 1rem;
    object-fit: cover;
    flex-shrink: 0;
  }

  .team-video {
    height: 16.5rem;
    width: 100%;
    overflow: hidden;
  }

  .team-video-placeholder {
    background-image: var(--videoUrl);
    background-size: cover;
    background-position: center;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    border-radius: 1rem;
  }
  /* --------------------- Product Section ---------------------*/
  .product-section {
    padding: 2rem;
    padding: 4rem 1.25rem;
    isolation: isolate;
  }

  .product-container {
    flex-direction: column;
    gap: 48px;
    isolation: isolate;
  }
  /* --------------------- Partners Section ---------------------*/
  .partners-section {
    background-color: var(--white);
    padding: 4rem 1.25rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 3rem;
  }

  .partners-head {
    width: 100%;
    max-width: 68.125rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .partners-title {
    font-family: var(--font-hanken);
    font-weight: 700;
    font-size: 2.25rem;
    text-transform: capitalize;
    color: var(--primary-900);
  }

  .partners-description {
    font-family: var(--font-hanken);
    font-weight: 400;
    font-size: 1rem;
    line-height: 1.4;
    color: var(--black);
  }

  .partners-grid {
    width: 100%;
    max-width: 68.125rem;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 2rem 1rem;
  }

  .partner-card {
    width: calc((100% - 2rem) / 3);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.125rem;
  }

  .partner-logo {
    width: 100%;
    height: 10rem;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .partner-logo img {
    width: 8rem;
    height: 8rem;
    object-fit: contain;
    transition:
      transform 0.25s ease,
      filter 0.25s ease;
    filter: grayscale(30%);
  }

  .partner-card:hover .partner-logo img {
    transform: scale(1.08);
    filter: grayscale(0%);
  }

  .partner-name {
    font-family: var(--font-hanken);
    font-weight: 400;
    line-height: 1.4;
    color: var(--black);
    text-align: center;
  }
  /* --------------------- Carousel Section ---------------------*/
  .carousel-section {
    background-color: var(--primary-900);
    color: var(--white);
    padding: 4rem 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  /* Tablet and above (min-width) */
  @media only screen and (min-width: 768px) {
    .hero-section {
      background-image: var(--hero-bg);
    }
    .team-section {
      padding: 6.25rem;
      flex-direction: row;
    }
    .partners-section {
      padding: 6.25rem;
      gap: 3rem;
    }
    .product-section {
      padding: 4.6875rem;
    }
    .partners-title {
      font-size: 3.625rem;
    }
    .carousel-section {
      padding: 4.6875rem;
    }
  }

  /* Desktop and above */
  @media only screen and (min-width: 1024px) {
    .hero-section {
      padding: 6rem 4rem;
    }
    .product-section {
      padding: 6.25rem;
    }
    .product-container {
      padding: 0 6.25rem;
    }
    .team-section {
      justify-content: center;
    }
    .team-video {
      width: 28.125rem;
      height: 21.25rem;
      border-radius: 1rem;
      overflow: hidden;
    }
    .team-content {
      width: 31.25rem;
    }
    .partners-section {
      padding: 3rem 2rem;
      gap: 3rem;
    }
    .partner-card {
      width: calc(20% - 0.8rem);
    }
  }
</style>
