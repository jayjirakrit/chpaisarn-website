---
const {
  bgImg = { src: "" },
  contactTitle = "Discover  Ch.Paisarn",
  contactDescription = "Get in touch with us",
  bgColor = "primary-900",
  titleColor = "white",
  desColor = "white",
} = Astro.props;
---

<section class="cta-section" style={`background-image: url(${bgImg.src});`}>
  <div class="cta-box" style={`background-color: var(--${bgColor});`}>
    <h2 class="cta-title" style={`color: var(--${titleColor});`}>
      {contactTitle}
    </h2>
    <p class="cta-description body-text-sm" style={`color: var(--${desColor});`}>
      {contactDescription}
    </p>
    <button class="cta-button">
      <span class="cta-button-text">Contact Us</span>
    </button>
  </div>
</section>

<style>
  .cta-section {
    background-size: cover;
    background-position: center;
    position: relative;
    padding: 3.125rem 1.25rem;
    display: flex;
    align-items: center;
    justify-content: flex-start;
  }

  .cta-box {
    background-color: var(--primary-900);
    border-radius: 5px;
    padding: 1.25rem;
    max-width: 446px;
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.15);
    position: relative;
    z-index: 10;
  }

  .cta-title {
    font-family: "Hanken Grotesk", sans-serif;
    font-weight: 700;
    font-size: 1.75rem;
    color: var(--titleColor);
    margin-bottom: 1.25rem;
  }

  .cta-description {
    color: white;
    line-height: 1.4;
    margin-bottom: 2rem;
  }

  .cta-button {
    background-color: #58bb90;
    border: none;
    border-radius: 5px;
    padding: 0.75rem 1.5rem;
    cursor: pointer;
    transition: background-color 0.3s ease;
  }

  .cta-button:hover {
    background-color: #4fa07d;
  }

  .cta-button-text {
    font-family: "Space Grotesk", sans-serif;
    font-weight: 700;
    font-size: 1rem;
    color: white;
  }

  /* Tablet and above (min-width) */
  @media only screen and (min-width: 768px) {
    .cta-section {
      padding: 6.25rem 9.375rem;
    }

    .cta-box {
      padding: 2.25rem;
    }
    
    .cta-title {
      font-size: 2.75rem;
    }

    .cta-description {
    }

    .cta-button-text {
      font-size: 1.5rem;
    }

    .cta-button {
      width: 50%;
    }
  }

  /* Desktop and above */
  @media only screen and (min-width: 1024px) {
  }
</style>
