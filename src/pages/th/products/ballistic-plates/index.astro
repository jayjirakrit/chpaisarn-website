---
import Plate from "@/components/Plate.astro";
import Layout from "@/layouts/Layout.astro";
import "@/styles/global.css";

const title = "แผ่นเกราะกันกระสุน — ช.ไพศาล (Chpaisarn)";
const description = "แผ่นเกราะ CHP® ให้การป้องกัน Level III ถึง Level IV ผ่านการรับรอง NIJ 0101.06 และ NIJ 0101.07 ออกแบบและทดสอบในประเทศไทย";
const keywords = "แผ่นเกราะกันกระสุน, แผ่นเกราะ Level III, แผ่นเกราะ Level IV, แผ่นเกราะ NIJ, แผ่นเกราะทหาร ช.ไพศาล";
---

<Layout title={title} description={description} keywords={keywords} lang="th">
  <Plate lang="th" />
