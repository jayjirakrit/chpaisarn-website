---
import ArmorInfo from "@/components/HelmetInfo.astro";
import Layout from "@/layouts/Layout.astro";
import "@/styles/global.css";
import { armorInfosTh } from "@/data/armor-info.th";
import { breadcrumbUrl } from "@/i18n/utils";
// ========== GENERATE STATIC PATHS ==========
export function getStaticPaths() {
  // ========== PRODUCT DATA ==========
  const products = armorInfosTh;

  return products.map((product) => ({
    params: { name: product.slug },
    props: { product },
  }));
}

// ========== ACCESS PROPS & BUILD DYNAMIC SEO ==========
const { product } = Astro.props;

// Dynamically build metadata based on the product
const title = `${product.name} — ช.ไพศาล (Chpaisarn)`;
const description = `เสื้อเกราะกันกระสุนจาก ช.ไพศาล ${product.name} ผลิตในประเทศไทยสำหรับหน่วยงานทหารและเจ้าหน้าที่บังคับใช้กฎหมาย`;
const keywords = `${product.name}, ${product.level}, เสื้อเกราะกันกระสุน ช.ไพศาล, เสื้อเกราะกันกระสุนไทย, เกราะกันกระสุน ${product.level}, ผู้ผลิตเสื้อเกราะไทย, ซื้อเสื้อเกราะกันกระสุน`;

const breadcrumbItems = [
  { name: "หน้าแรก", item: breadcrumbUrl("th", "/") },
  { name: "สินค้า", item: breadcrumbUrl("th", "/products") },
  { name: product.name, item: breadcrumbUrl("th", `/products/${product.slug}`) },
];
---

<!-- ========== PAGE TEMPLATE ========== -->
<Layout
  title={title}
  description={description}
  keywords={keywords}
  lang="th">
  <ArmorInfo productInfo={product} lang="th" breadcrumbItems={breadcrumbItems} />
</Layout>
