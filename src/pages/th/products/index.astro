---
import Armour from "@/components/Armour.astro";
import Layout from "@/layouts/Layout.astro";
import "@/styles/global.css";

const title = "สินค้าเกราะป้องกัน — ช.ไพศาล (Chpaisarn)";
const description = "สำรวจสินค้าเกราะป้องกันของ ช.ไพศาล: เสื้อเกราะกันกระสุน หมวกกันกระสุน แผ่นเกราะ และโซลูชันป้องกันกำหนดเอง ผลิตในประเทศไทย";
const keywords = "เสื้อเกราะกันกระสุน, แผ่นเกราะ NIJ, สินค้า ช.ไพศาล, เกราะป้องกันทหาร, อุปกรณ์ทหารไทย";
---

<Layout title={title} description={description} keywords={keywords} lang="th">
  <Armour lang="th" />
</Layout>
