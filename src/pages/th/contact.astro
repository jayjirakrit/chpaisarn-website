---
import ContactUs from "@/components/ContactUs.astro";
import Layout from "@/layouts/Layout.astro";
import "@/styles/global.css";

const title = "ติดต่อ ช.ไพศาล — สอบถามและสั่งซื้อสินค้า";
const description = "ติดต่อทีมงาน ช.ไพศาล เพื่อสอบถามเกี่ยวกับสินค้าเกราะป้องกัน การสั่งซื้อ หรือรับคำแนะนำจากผู้เชี่ยวชาญ";
const keywords = "ติดต่อ ช.ไพศาล, สั่งซื้อเกราะกันกระสุน, ติดต่อบริษัทเกราะไทย";
---

<Layout title={title} description={description} keywords={keywords} lang="th">
  <ContactUs lang="th" />
</Layout>
