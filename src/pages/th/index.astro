---
import Home from "@/components/Home.astro";
import Layout from "@/layouts/Layout.astro";
import "@/styles/global.css";

const title = "ช.ไพศาล (Chpaisarn) — อุปกรณ์ทหารคุณภาพสูง";
const description = "ช.ไพศาล ออกแบบและผลิตเครื่องป้องกันแบลลิสติกในประเทศไทย: เสื้อเกราะกันกระสุน หมวกกันกระสุน และแผ่นเกราะ NIJ สำหรับทหารและเจ้าหน้าที่บังคับใช้กฎหมาย";
const keywords = "ช.ไพศาล, บริษัท ช.ไพศาล, บริษัท ช.ไพศาล จำกัด, เว็บไซต์ ช.ไพศาล, เว็ปไซต์ ช.ไพศาล, chpaisarn, chpaisarn.com, เสื้อเกราะกันกระสุน, หมวกกันกระสุน, แผ่นเกราะกันกระสุน, ผู้ผลิตเกราะป้องกันในไทย, โรงงานผลิตเกราะกันกระสุน, อุปกรณ์ทหาร, เกราะ NIJ";
---

<Layout title={title} description={description} keywords={keywords} lang="th">
  <Home lang="th" />
</Layout>
